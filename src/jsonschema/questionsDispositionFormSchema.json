{
    "title": "Questions disponibilités et contraintes",
    "type": "object",
    "required": [
        "titre",
        "introduction",
        "questions"
    ],
    "properties": {
        "titre": {
            "type": "string",
            "title": "Nom du questionnaire",
            "default": "Questions disposition (logistiques et contraintes)"
        },
        "introduction": {
            "type": "string",
            "title": "Phrase d'introduction aux questions",
            "format": "textarea",
            "default": "Nous avons besoin de quelques informations pour vous recontacter et mettre en place l'immersion."
        },
        "questions": {
            "type": "array",
            "title": "Questions",
            "format": "tabs",
            "uniqueItems": true,
            "options": {
                "disable_array_delete_all_rows": true,
                "disable_array_delete_last_row": true
            },
            "items": {
                "type": "object",
                "title": "Question",
                "headerTemplate": "{{ self.label_employeur }}",
                "required": [
                    "type_reponse"
                ],
                "properties": {
                    "label_participant": {
                        "type": "string",
                        "title": "Intitulé Participant·e"
                    },
                    "label_employeur": {
                        "type": "string",
                        "title": "Intitulé Employeur·euse"
                    },
                    "type_reponse": {
                        "type": "string",
                        "title": "Type de réponse",
                        "default": "réponse libre",
                        "enum": [
                            "choix unique",
                            "choix multiples",
                            "réponse libre",
                            "choix dates multiples"
                        ]
                    },
                    "contrainte_majeure": {
                        "type": "boolean",
                        "title": "Contrainte limitante pour l'immersion",
                        "default": false,
                        "format": "checkbox",
                        "description": "Une alerte sera remontée si le participant obtient un score inférieur à celui demandé par l'employeur. Les réponses doivent être ordonnées du moins favorable (1) au plus favorable (valeur la plus haute). La valeur 0 correspond à « je ne souhaite pas répondre » et est ignorée.",
                        "options": {
                            "dependencies": {
                                "type_reponse": [
                                    "choix unique",
                                    "choix multiples"
                                ]
                            }
                        }
                    },
                    "reponses_possibles": {
                        "title": "Réponses (Choix)",
                        "type": "array",
                        "format": "table",
                        "options": {
                            "disable_array_delete_all_rows": true,
                            "disable_array_delete_last_row": true,
                            "disable_array_reorder": true,
                            "dependencies": {
                                "type_reponse": [
                                    "choix unique",
                                    "choix multiples"
                                ]
                            }
                        },
                        "items": {
                            "title": "Réponse",
                            "type": "object",
                            "properties": {
                                "valeur": {
                                    "type": "integer",
                                    "title": "Score",
                                    "default": 1
                                },
                                "libelle_participant": {
                                    "type": "string",
                                    "title": "Libellé Participant·e"
                                },
                                "libelle_employeur": {
                                    "type": "string",
                                    "title": "Libellé Employeur·euse"
                                }
                            }
                        }
                    },
                    "dates_possibles": {
                        "title": "Dates proposées",
                        "type": "array",
                        "format": "table",
                        "options": {
                            "disable_array_delete_all_rows": true,
                            "disable_array_delete_last_row": true,
                            "dependencies": {
                                "type_reponse": "choix dates multiples"
                            }
                        },
                        "items": {
                            "type": "string",
                            "title": "Date",
                            "format": "date"
                        }
                    },
                    "config_texte_libre": {
                        "type": "string",
                        "title": "Texte par défaut (optionnel)",
                        "description": "Exemple: \"Si vous avez d'autres choses à signaler, veuillez compléter ce champ.\"",
                        "default": "",
                        "options": {
                            "dependencies": {
                                "type_reponse": "réponse libre"
                            }
                        }
                    }
                }
            },
            "default": [
                {
                    "label_employeur": "Ce poste est en horaires décalées ?",
                    "label_participant": "Vous pouvez travailler en horaires atypiques, en décalés ?",
                    "type_reponse": "choix unique",
                    "reponses_possibles": [
                        { "valeur": 3, "libelle_participant": "Oui", "libelle_employeur": "Oui" },
                        { "valeur": 2, "libelle_participant": "Parfois", "libelle_employeur": "Parfois" },
                        { "valeur": 1, "libelle_participant": "Non", "libelle_employeur": "Non" },
                        { "valeur": 0, "libelle_participant": "Vous ne souhaitez pas répondre", "libelle_employeur": "Vous ne souhaitez pas répondre" }
                    ]
                }
            ]
        }
    }
}
