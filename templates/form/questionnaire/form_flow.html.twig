{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<link rel="stylesheet" href="{{ asset('styles/questionnaire.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://cdn.jsdelivr.net/npm/@json-editor/json-editor@latest/dist/jsoneditor.min.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
JSONEditor.defaults.options.theme = 'bootstrap5';
JSONEditor.defaults.options.iconlib = 'fontawesome5';
JSONEditor.defaults.language = 'fr';
JSONEditor.defaults.languages.fr = {
    error_maxLength: "La valeur doit contenir au maximum {{ '{{0}}' }} caractère(s)",
    error_minLength: "La valeur doit contenir au moins {{ '{{0}}' }} caractère(s)",
    error_maxItems: "Veuillez sélectionner au maximum {{ '{{0}}' }} élément(s)",
    error_minItems: "Veuillez sélectionner au moins {{ '{{0}}' }} élément(s)",
    error_enum: "Veuillez sélectionner une proposition",
    error_notempty: "Ce champ est obligatoire",
}

document.querySelectorAll('.js-json-editor-container').forEach(container => {
const inputId = container.dataset.inputId;
const input = document.getElementById(inputId);

if (! input)
return;



let schema = {};
let options = {};
try {
schema = JSON.parse(container.dataset.schema);
options = JSON.parse(container.dataset.options || '{}');
} catch (e) {
console.error('Erreur parsing JSON config', e);
return;
}

let startVal = null;
try {
const parsed = JSON.parse(input.value);
if (parsed && Object.keys(parsed).length > 0) {
startVal = parsed;
}
} catch (e) {}

const editorOptions = { schema: schema, ...options };
if (startVal !== null) {
    editorOptions.startval = startVal;
    editorOptions.show_errors = 'always';
}

const editor = new JSONEditor(container, editorOptions);

editor.on('change', function () {
if (editor.ready) {
input.value = JSON.stringify(editor.getValue());
}
});
});

const autresMesuresWrapper = document.querySelector('[data-autres-mesures-wrapper]');
if (autresMesuresWrapper) {
	const autresMesuresRadios = autresMesuresWrapper.querySelectorAll('input[type="radio"]');
	const precisionWrapper = document.getElementById('precision-mesures-wrapper');

	function togglePrecisionMesures() {
		const selectedRadio = autresMesuresWrapper.querySelector('input[type="radio"]:checked');
		if (selectedRadio && selectedRadio.value === '1') {
			precisionWrapper.classList.remove('d-none');
		} else {
			precisionWrapper.classList.add('d-none');
			const textarea = precisionWrapper ? precisionWrapper.querySelector('textarea') : null;
			if (textarea) textarea.value = '';
		}
	}

	autresMesuresRadios.forEach(radio => radio.addEventListener('change', togglePrecisionMesures));
	togglePrecisionMesures();
}

const communeSelect = document.querySelector('[data-commune-select]');
if (communeSelect) {
	const autreWrapper = document.getElementById('commune-autre-wrapper');
	const communeAutreInput = autreWrapper ? autreWrapper.querySelector('input') : null;

	function toggleCommuneAutre() {
		if (communeSelect.value === 'Autre') {
			autreWrapper.classList.remove('d-none');
			if (communeAutreInput) communeAutreInput.required = true;
		} else {
			autreWrapper.classList.add('d-none');
			if (communeAutreInput) {
				communeAutreInput.required = false;
				communeAutreInput.value = '';
			}
		}
	}

	communeSelect.addEventListener('change', toggleCommuneAutre);
	toggleCommuneAutre();
}
});
	</script>
{% endblock %}

{% block body %}
	{% set is_pro = app.request.query.has('pro') %}
	{% embed 'form/questionnaire/_layout.html.twig' with { form: form } %}
		{% block content %}
			<div class="form-container">
				{{ form_start(form, {'attr': {'class': 'd-flex flex-column h-100'}}) }}

				<div class="px-4 pt-4 pb-5 px-md-5 pt-md-5 flex-grow-1">
					{% set current_step = form.vars.cursor.currentStep %}
					{% set current_step_block = 'questionnaire_' ~ current_step ~ '_step' %}

					<div class="mb-4 text-center text-md-start">
						<h2 class="h2 fw-bold mb-2">
							{% if current_step == 'contact' %}
								{{ is_pro ? 'Fiche contact' : 'Vos informations' }}
							{% endif %}
							{% if current_step == 'reponsesScore' %}Questionnaire
							{% endif %}
							{% if current_step == 'reponsesDisposition' %}Vos disponibilités
							{% endif %}
						</h2>
						{% if current_step == 'reponsesScore' and introductionScore %}
							<p class="text-muted">{{ introductionScore }}</p>
						{% elseif current_step == 'reponsesDisposition' and introductionDisposition %}
							<p class="text-muted">{{ introductionDisposition }}</p>
						{% endif %}
					</div>

					{% if block(current_step_block) is defined %}
						{{ block(current_step_block) }}
					{% else %}
						{{ form_widget(form[current_step]) }}
					{% endif %}
				</div>

			</div>
			<div class="form-nav py-3 px-4 px-md-5">
				<div>
					{% if form.navigator.back is defined %}
						{{ form_widget(form.navigator.back, {
                                        attr: {class: 'btn-prev'},
                                        label_html: true,
                                        label: '<i class="fas fa-arrow-left me-2"></i> Précédent',
                                    }) }}
					{% endif %}
				</div>
				<div class="d-flex gap-2">
					{% if form.navigator.next is defined %}
						{{ form_widget(form.navigator.next, {
                                        attr: {class: 'btn-next'},
                                        label_html: true,
                                        label: 'Suivant <i class="fas fa-arrow-right ms-2"></i>',
                                    }) }}
					{% endif %}
					{% if form.navigator.finish is defined %}
						{{ form_widget(form.navigator.finish, {
                                        attr: {class: 'btn-next'},
                                        label_html: true,
                                        label: 'Terminer <i class="fas fa-arrow-right ms-2"></i>'
                                    }) }}
					{% endif %}
				</div>
				{{ form_row(form._token) }}
				{{ form_end(form, {'render_rest': false}) }}
			</div>
		{% endblock %}

		{% macro render_json_editor_widget(form_field) %}
			<div class="json-editor-wrapper">
				{{ form_widget(form_field, {'attr': {'data-json-editor': 'true'}}) }}

				<div class="js-json-editor-container" data-input-id="{{ form_field.vars.id }}" data-schema="{{ form_field.vars.json_schema|default('{}')|e('html_attr') }}" data-options="{{ form_field.vars.editor_options|default('{}')|e('html_attr') }}"></div>

				{{ form_errors(form_field) }}
			</div>
		{% endmacro %}
		{% block questionnaire_contact_step %}
			{% set is_pro = app.request.query.has('pro') %}
			{% if is_pro %}
				{% do form.contact.type.setRendered() %}
				<input type="hidden" name="{{ form.contact.type.vars.full_name }}" value="employeur">
			{% else %}
				{% do form.contact.type.setRendered() %}
				<input type="hidden" name="{{ form.contact.type.vars.full_name }}" value="participant">
			{% endif %}

			<div class="d-flex flex-column gap-2">

				<div class="p-4 rounded-4 shadow-lg">
					<h6 class="h4 text-green fw-bold mb-3">{% if is_pro %}Coordonnées du signataire de la convention de stage{% else %}Votre identité{% endif %}</h6>
					<div class="row gx-3 gy-4">
						<div class="col-lg-6">
							{{ form_row(form.contact.prenom, {'attr': {'class': 'form-control'}}) }}
						</div>
						<div class="col-lg-6">
							{{ form_row(form.contact.nomFamille, {'attr': {'label': 'Nom','class': 'form-control'}}) }}
						</div>
						{% if is_pro %}
						<div class="col-lg-12">
							{{ form_row(form.contact.fonctionSignataire, {'attr': {'class': 'form-control'}}) }}
						</div>
						{% else %}
							{% do form.contact.fonctionSignataire.setRendered() %}
						{% endif %}
						<div class="col-6">
							{{ form_row(form.contact.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
						</div>
						{% if not is_pro %}
							<div class="col-lg-6">
								{{ form_row(form.contact.commune, {'attr': {'class': 'form-select', 'data-commune-select': 'true'}}) }}
							</div>
						{% endif %}
						<div class="col-lg-6">
							{{ form_row(form.contact.numeroTelephone, {'attr': {'class': 'form-control', 'placeholder': '06 12 34 56 78'}}) }}
						</div>
						{% if not is_pro %}
							<div class="col-lg-6 d-none" id="commune-autre-wrapper">
								{{ form_row(form.contact.communeAutre, {'attr': {'class': 'form-control'}}) }}
							</div>
						{% endif %}
					</div>
				</div>

				{% if not is_pro %}
					<div class="col-12 mt-4">
						<div class="p-4 rounded-4 shadow-lg">
							<h6 class="h4 text-green fw-bold mb-3">Votre situation</h6>
							<div class="row gx-3 gy-4">
								<div class="col-lg-6">
									{{ form_row(form.contact.situation, {'attr': {'class': 'form-select'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.trancheAge, {'attr': {'class': 'form-select'}}) }}
								</div>
							</div>
						</div>
					</div>
					<div class="col-12 mt-4">
						<div class="p-4 rounded-4 shadow-lg">
							<h6 class="h4 text-green fw-bold mb-3">Référent·e (optionnel)</h6>
							<div class="mb-3">
								<small class="text-muted">
									<i class="fas fa-info-circle me-1"></i>
									À compléter si vous êtes suivi·e par un·e référent·e de structure (scolaire, mission locale, france travail...)
								</small>
							</div>
							<div class="row g-3">
								<div class="col-md-12">
									{{ form_row(form.contact.referent, {'attr': {'class': 'form-select'}}) }}
								</div>
							</div>
						</div>
					</div>
					{% do form.contact.nomEntreprise.setRendered() %}
					{% do form.contact.secteurActivite.setRendered() %}
					{% do form.contact.nombreEmployes.setRendered() %}
					{% do form.contact.adresseEntreprise.setRendered() %}
					{% do form.contact.metier.setRendered() %}
					{% do form.contact.nombreImmersion.setRendered() %}
					{% do form.contact.immersionMemeDate.setRendered() %}
					{% do form.contact.prenomTuteur.setRendered() %}
					{% do form.contact.nomFamilleTuteur.setRendered() %}
					{% do form.contact.fonctionTuteur.setRendered() %}
					{% do form.contact.emailTuteur.setRendered() %}
					{% do form.contact.telephoneTuteur.setRendered() %}
					{% do form.contact.siret.setRendered() %}
					{% do form.contact.horaires.setRendered() %}
					{% do form.contact.epiDisponible.setRendered() %}
					{% do form.contact.autresMesuresPrevention.setRendered() %}
					{% do form.contact.precisionMesuresPrevention.setRendered() %}
				{% else %}
					<div class="col-12 mt-4">
						<div class="p-4 rounded-4 shadow-lg">
							<div class="row g-3">
								<h6 class="h4 text-green fw-bold mb-3">Informations entreprise</h6>
								<div class="col-12">
									{{ form_row(form.contact.nomEntreprise, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.secteurActivite, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.nombreEmployes, {'attr': {'class': 'form-select'}}) }}
								</div>
								<div class="col-lg-12">
									{{ form_row(form.contact.adresseEntreprise, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.commune, {'attr': {'class': 'form-select'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.siret, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-12">
									{{ form_row(form.contact.metier, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.nombreImmersion, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-12" id="immersion-meme-date-wrapper">
									{{ form_row(form.contact.immersionMemeDate) }}
								</div>
								<div class="col-lg-12">
									{{ form_row(form.contact.horaires, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-12">
									{{ form_row(form.contact.epiDisponible) }}
								</div>
								<div class="col-12" data-autres-mesures-wrapper="true">
									{{ form_row(form.contact.autresMesuresPrevention) }}
								</div>
								<div class="col-12 d-none" id="precision-mesures-wrapper">
									{{ form_row(form.contact.precisionMesuresPrevention, {'attr': {'class': 'form-control'}}) }}
								</div>
							</div>
						</div>
					</div>
					<div class="col-12 mt-4">
						<div class="p-4 rounded-4 shadow-lg">
							<div class="row g-3">
								<h6 class="h4 text-green fw-bold mb-3">Tuteur ou tutrice pendant l'immersion</h6>
								<div>
									<small class="text-muted">
										<i class="fas fa-info-circle me-1"></i>
										Peut être la même personne que le signataire de la convention.
									</small>
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.prenomTuteur, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.nomFamilleTuteur, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-12">
									{{ form_row(form.contact.fonctionTuteur, {'attr': {'class': 'form-control'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.emailTuteur, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
								</div>
								<div class="col-lg-6">
									{{ form_row(form.contact.telephoneTuteur, {'attr': {'class': 'form-control', 'placeholder': '06 12 34 56 78'}}) }}
								</div>
							</div>
						</div>
					</div>

					{% do form.contact.situation.setRendered() %}
					{% do form.contact.trancheAge.setRendered() %}
					{% do form.contact.referent.setRendered() %}
				{% endif %}
				{% do form.contact.setRendered() %}
			</div>
		{% endblock %}
		{% block questionnaire_reponsesScore_step %}

			{{ _self.render_json_editor_widget(form.reponsesScore.reponses) }}

			{% do form.reponsesScore.setRendered() %}
		{% endblock %}
		{% block questionnaire_reponsesDisposition_step %}

			{{ _self.render_json_editor_widget(form.reponsesDisposition.reponses) }}

			{% do form.reponsesDisposition.setRendered() %}
		{% endblock %}
	{% endembed %}
{% endblock %}
