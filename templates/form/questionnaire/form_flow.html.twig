{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8f9fa; }

        .sidebar { background-color: #fff; border-right: 1px solid #dee2e6; }
        .step-item { position: relative; padding-bottom: 2rem; }
        .step-item:last-child { padding-bottom: 0; }

        .step-item::before {
            content: ''; position: absolute; left: 15px; top: 35px; bottom: 0;
            width: 2px; background-color: #e9ecef; z-index: 0;
        }
        .step-item:last-child::before { display: none; }

        .step-icon {
            width: 32px; height: 32px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            background-color: #fff; border: 2px solid #dee2e6;
            color: #adb5bd; z-index: 1; position: relative;
            transition: all 0.3s ease;
        }

        .step-item.active .step-icon {
            border-color: #0d6efd; color: #0d6efd; box-shadow: 0 0 0 4px rgba(13,110,253,0.1);
        }
        .step-item.active .step-label { color: #0d6efd; font-weight: 700; }

        .step-item.completed .step-icon {
            background-color: #198754; border-color: #198754; color: #fff;
        }
        .step-item.completed .step-label { color: #198754; }
        .step-item.completed::before { background-color: #198754; }

        .form-card { border-radius: 1rem; border: none; box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05); overflow: hidden; }

        textarea[data-json-editor="true"] {
            display: none !important;
        }

        .je-object__title { font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: #495057; }
        .je-indented-panel { border: 1px solid #dee2e6; padding: 1.5rem; border-radius: 0.5rem; background-color: #fff; margin-bottom: 1rem; }

        .card-body.p-0 .je-indented-panel { border: none; padding: 0; }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/@json-editor/json-editor@latest/dist/jsoneditor.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            JSONEditor.defaults.options.theme = 'bootstrap5';
            JSONEditor.defaults.options.iconlib = 'fontawesome5';

            document.querySelectorAll('.js-json-editor-container').forEach(container => {
                const inputId = container.dataset.inputId;
                const input = document.getElementById(inputId);

                if (!input) return;

                let schema = {};
                let options = {};
                try {
                    schema = JSON.parse(container.dataset.schema);
                    options = JSON.parse(container.dataset.options || '{}');
                } catch(e) {
                    console.error('Erreur parsing JSON config', e);
                    return;
                }

                let startVal = {};
                try {
                    startVal = JSON.parse(input.value);
                } catch(e) {
                }

                const editor = new JSONEditor(container, {
                    schema: schema,
                    startval: startVal,
                    ...options
                });

                editor.on('change', function() {
                    if(editor.ready) {
                        input.value = JSON.stringify(editor.getValue());
                    }
                });
            });
        });
    </script>
{% endblock %}

{% block body %}
    {% set is_pro = app.request.query.has('pro') %}
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="card form-card">
                <div class="row g-0">

                    <div class="col-md-4 sidebar p-4 d-none d-md-block">
                        <h5 class="mb-4 fw-bold text-primary px-2">Étapes</h5>
                        <div class="d-flex flex-column">
                            {% for step in form.vars.visible_steps %}
                                {% set step_class = '' %}
                                {% if step.is_current_step %}
                                    {% set step_class = 'active' %}
                                {% elseif step.index < form.vars.cursor.stepIndex %}
                                    {% set step_class = 'completed' %}
                                {% endif %}

                                <div class="d-flex gap-3 step-item {{ step_class }}">
                                    <div class="step-icon">
                                        {% if step_class == 'completed' %}
                                            <i class="fas fa-check small"></i>
                                        {% elseif step_class == 'active' %}
                                            <i class="fas fa-circle small"></i>
                                        {% else %}
                                            <span class="small fw-bold">{{ step.index + 1 }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="pt-1">
                                        <div class="step-label mb-0">
                                            {% if step.name == 'contact' %}{{ is_pro ? 'Fiche contact' : 'Vos informations' }}{% endif %}
                                            {% if step.name == 'reponsesScore' %}Questionnaire{% endif %}
                                            {% if step.name == 'reponsesDisposition' %}Disponibilité{% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="col-md-8 bg-white">
                        {{ form_start(form, {'attr': {'class': 'd-flex flex-column h-100'}}) }}

                        <div class="p-4 p-md-5 flex-grow-1">
                            {% set current_step = form.vars.cursor.currentStep %}
                            {% set current_step_block = 'questionnaire_' ~ current_step ~ '_step' %}

                            <div class="mb-4">
                                <h2 class="h4 fw-bold mb-2">
                                    {% if current_step == 'contact' %}
                                        {{ is_pro ? 'Fiche contact' : 'Vos informations' }}
                                    {% endif %}
                                    {% if current_step == 'reponsesScore' %}Questionnaire{% endif %}
                                    {% if current_step == 'reponsesDisposition' %}Vos dispositions{% endif %}
                                </h2>
                                {% if current_step == 'contact' and is_pro is defined and is_pro is true %}
                                    <p class="text-muted small">Veuillez saisir le contact de la personne qui assurera le suivi de l'immersion professionnelle.</p>
                                {% endif %}
                                <hr class="opacity-10">
                            </div>

                            {% if block(current_step_block) is defined %}
                                {{ block(current_step_block) }}
                            {% else %}
                                {{ form_widget(form[current_step]) }}
                            {% endif %}
                        </div>

                        <div class="p-4 bg-light border-top d-flex justify-content-between align-items-center">
                            <div>
                                {% if form.navigator.back is defined %}
                                    {{ form_widget(form.navigator.back, {
                                        attr: {class: 'btn btn-outline-secondary btn-sm px-4'},
                                        label: 'Précédent'
                                    }) }}
                                {% endif %}
                            </div>
                            <div class="d-flex gap-2">
                                {% if form.navigator.next is defined %}
                                    {{ form_widget(form.navigator.next, {
                                        attr: {class: 'btn btn-primary btn-sm px-4'},
                                        label: 'Suivant'
                                    }) }}
                                {% endif %}
                                {% if form.navigator.finish is defined %}
                                    {{ form_widget(form.navigator.finish, {
                                        attr: {class: 'btn btn-success btn-sm px-4 fw-bold'},
                                        label: 'Terminer'
                                    }) }}
                                {% endif %}
                            </div>
                        </div>

                        {{ form_row(form._token) }}
                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% macro render_json_editor_widget(form_field) %}
    <div class="json-editor-wrapper mb-3">
        {{ form_widget(form_field, {'attr': {'data-json-editor': 'true'}}) }}

        <div class="js-json-editor-container"
             data-input-id="{{ form_field.vars.id }}"
             data-schema="{{ form_field.vars.json_schema|default('{}')|e('html_attr') }}"
             data-options="{{ form_field.vars.editor_options|default('{}')|e('html_attr') }}"
        ></div>

        {{ form_errors(form_field) }}
    </div>
{% endmacro %}

{% block questionnaire_contact_step %}
    {% set is_pro = app.request.query.has('pro') %}
    {% if is_pro %}
        {% do form.contact.type.setRendered() %}
        <input type="hidden" name="{{ form.contact.type.vars.full_name }}" value="employeur">
    {% else %}
        {% do form.contact.type.setRendered() %}
        <input type="hidden" name="{{ form.contact.type.vars.full_name }}" value="participant">
    {% endif %}

    <div class="row g-3">
        <div class="col-md-6">
            {{ form_row(form.contact.prenom, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.contact.nomFamille, {'attr': {'label': 'Nom','class': 'form-control'}}) }}
        </div>
        <div class="col-12">
            {{ form_row(form.contact.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.contact.numeroTelephone, {'attr': {'class': 'form-control', 'placeholder': '06 12 34 56 78'}}) }}
        </div>
        {% if not is_pro %}
            <div class="col-md-6">
                {{ form_row(form.contact.commune, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="col-12 mt-4">
                <div class="p-3 bg-light rounded-3 border">
                    {{ form_row(form.contact.situation, {'attr': {'class': 'form-select'}}) }}
                    <div class="mt-3">
                        {{ form_row(form.contact.trancheAge, {'attr': {'class': 'form-select'}}) }}
                    </div>
                </div>
            </div>
            <div class="col-12 mt-4">
                <div class="p-3 bg-light rounded-3 border">
                    <h6 class="fw-bold mb-3 text-secondary">Référent·e (optionnel)</h6>
                    <div class="mb-3">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            À compléter si vous êtes suivi·e par un·e référent·e de structure (scolaire, mission locale, france travail...)
                        </small>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_row(form.contact.prenomReferent, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.contact.nomReferent, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.contact.structureReferent, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                </div>
            </div>
            {% do form.contact.nomEntreprise.setRendered() %}
            {% do form.contact.secteurActivite.setRendered() %}
            {% do form.contact.nombreEmployes.setRendered() %}
            {% do form.contact.metier.setRendered() %}
            {% do form.contact.prenomTuteur.setRendered() %}
            {% do form.contact.nomFamilleTuteur.setRendered() %}
        {% else %}
            <div class="col-12 mt-4">
                <div class="p-3 bg-light rounded-3 border">
                    <div class="row g-3">
                        <h6 class="fw-bold text-secondary">Informations entreprise</h6>
                        <div class="col-12">
                            {{ form_row(form.contact.nomEntreprise, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.contact.secteurActivite, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.contact.nombreEmployes, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-12">
                            {{ form_row(form.contact.commune, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-12">
                            {{ form_row(form.contact.metier, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div>
                            <h6 class="fw-bold text-secondary">Tuteur·ice professionnel·le</h6>
                            <div>
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Personne qui accompagnera durant l'immersion (peut être la même personne que le contact).
                                </small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.contact.prenomTuteur, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.contact.nomFamilleTuteur, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                </div>
            </div>
            {% do form.contact.situation.setRendered() %}
            {% do form.contact.trancheAge.setRendered() %}
            {% do form.contact.nomReferent.setRendered() %}
            {% do form.contact.prenomReferent.setRendered() %}
            {% do form.contact.structureReferent.setRendered() %}
        {% endif %}
        {% do form.contact.setRendered() %}
    </div>
{% endblock %}

{% block questionnaire_reponsesScore_step %}
    <div class="alert alert-primary d-flex align-items-center mb-4" role="alert">
        <i class="fas fa-info-circle me-3 fs-4"></i>
        <div>
            Répondez aux questions ci-dessous pour nous aider à évaluer votre profil.
        </div>
    </div>

    {{ _self.render_json_editor_widget(form.reponsesScore.reponses) }}

    {% do form.reponsesScore.setRendered() %}
{% endblock %}

{% block questionnaire_reponsesDisposition_step %}
    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
        <i class="fas fa-check-circle me-3 fs-4"></i>
        <div>
            Dernière ligne droite ! Indiquez vos dispositions.
        </div>
    </div>

    {{ _self.render_json_editor_widget(form.reponsesDisposition.reponses) }}

    {% do form.reponsesDisposition.setRendered() %}
{% endblock %}
