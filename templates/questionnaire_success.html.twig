{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('styles/questionnaire.css') }}">
{% endblock %}

{% block title %}Merci !
{% endblock %}

{% block body %}
    {% embed 'form/questionnaire/_layout.html.twig' %}
        {% block content %}
            <div class="success px-5 text-center d-flex flex-column gap-1 align-items-center justify-content-center flex-grow-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-check-circle-fill text-green" viewbox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8
8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                </svg>
                <h1 class="h1 text-green fw-bold">Merci pour votre participation&nbsp;!</h1>
                <p class="text-muted">
                    Vos réponses
                    ont été enregistrées avec succès.
                    <br>
                    Vous serez bientôt recontacté par mail ou par téléphone.
                </p>
                {% if app.request.query.has('pro') and questionnaire_id %}
                    <div class="mt-4">
                        <form action="{{ path('app_questionnaire_restart') }}" method="POST">
                            <input type="hidden" name="questionnaire_id" value="{{ questionnaire_id }}">
                            <input type="hidden" name="pro" value="1">
                            <button type="submit" class="btn btn-next px-4">
                                <i class="fas
fa-plus me-2"></i>
                                Ajouter un autre métier (ou autre immersion pour ce métier)
                            </button>
                        </form>

                    </div>
                {% endif %}
            </div>
        {% endblock %}


    {% endembed %}
{% endblock %}
