{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Modification des réponses
    <br>
    <small class="text-muted">
        Questionnaire {{ questionnaire.session.nom|default('') }}
    </small>
{% endblock %}

{% block head_javascript %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/@json-editor/json-editor@latest/dist/jsoneditor.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var containers = document.querySelectorAll('.js-json-editor-container');

            containers.forEach(function(container) {
                var inputId = container.dataset.inputId;
                var schema = JSON.parse(container.dataset.schema);
                var options = JSON.parse(container.dataset.options);
                var startVal = JSON.parse(container.dataset.startval);

                // To prevent ID collisions between the 2 json editors form
                var uniqueRootName = 'root_' + inputId;

                var editorOptions = Object.assign({}, options, {
                    schema: schema,
                    theme: 'bootstrap5',
                    iconlib: 'fontawesome5',
                    form_name_root: uniqueRootName
                });

                var editor = new JSONEditor(container, editorOptions);

                editor.on('ready', function() {
                    editor.setValue(startVal);
                });

                var textarea = document.getElementById(inputId);
                editor.on('change', function() {
                    var value = editor.getValue();
                    textarea.value = JSON.stringify(value);
                });
            });
        });
    </script>
{% endblock %}

{% block page_actions %}
    <a class="btn btn-secondary" href="{{ backUrl }}">
        Retour à la liste
    </a>
    <button type="submit" class="btn btn-primary" form="edit-answers-form">
        <i class="fa fa-save me-1"></i> Enregistrer les modifications
    </button>
{% endblock %}

{% macro render_json_editor_widget(form_field) %}
    <div class="js-json-editor-container"
         data-input-id="{{ form_field.vars.id }}"
         data-schema="{{ form_field.vars.json_schema|default('{}')|e('html_attr') }}"
         data-options="{{ form_field.vars.editor_options|default('{}')|e('html_attr') }}"
         data-startval="{{ form_field.vars.value|default('{}')|e('html_attr') }}">
    </div>

    <div style="display:none;">
        {{ form_widget(form_field) }}
    </div>
{% endmacro %}

{% block main %}
    <div class="row">
        <div class="col-12 col-xxl-10">
            <div class="card">
                <div class="card-body">

                    {{ form_start(form, {'attr': {'id': 'edit-answers-form'}}) }}

                    {{ form_errors(form) }}

                    {% if questionnaire.contact %}
                        <div class="d-flex align-items-center justify-content-between p-3 mb-4 bg-light rounded border">
                            <div>
                                <i class="fa fa-user me-2 text-secondary"></i>
                                <strong>{{ questionnaire.contact.prenom }} {{ questionnaire.contact.nomFamille }}</strong>
                                {% if questionnaire.type == 'employeur' %}
                                    <span class="badge badge-success ms-2">Employeur·euse</span>
                                {% else %}
                                    <span class="badge badge-primary ms-2">Participant·e</span>
                                {% endif %}
                                <span class="text-muted ms-2">{{ questionnaire.contact.email }}</span>
                            </div>
                            <div>
                                {% set contactUrl = ea_url()
                                    .setController('App\\Controller\\Admin\\ContactCrudController')
                                    .setAction('edit')
                                    .setEntityId(questionnaire.contact.id) %}
                                <a href="{{ contactUrl }}" class="btn btn-secondary">
                                    <i class="fa fa-edit me-1"></i> Modifier les informations du contact
                                </a>
                            </div>
                        </div>
                    {% endif %}

                    <div class="mb-5">
                        {% if form.reponsesDisposition.reponses is defined %}
                            {{ _self.render_json_editor_widget(form.reponsesDisposition.reponses) }}
                        {% else %}
                            {{ form_widget(form.reponsesDisposition) }}
                        {% endif %}
                    </div>

                    <div class="mb-4">
                        {% if form.reponsesScore.reponses is defined %}
                            {{ _self.render_json_editor_widget(form.reponsesScore.reponses) }}
                        {% else %}
                            {{ form_widget(form.reponsesScore) }}
                        {% endif %}
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top gap-2">
                        <a class="btn btn-secondary" href="{{ backUrl }}">
                            Retour à la liste
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i> Enregistrer les modifications
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
