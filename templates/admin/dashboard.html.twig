{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}Tableau de bord{% endblock %}

{% block main %}
    {% if stats %}
        {% if hasActiveSession %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="d-flex flex-row gap-2 h-100">
                    {% if inscriptionVolontaireOuverte %}
                        <a href="{{ path('app_questionnaire_new') }}" target="_blank" class="btn btn-action-dashboard h-50 d-flex align-items-center justify-content-center">
                            <i class="fas fa-user me-2"></i> Accès formulaire volontaires
                        </a>
                    {% endif %}
                    {% if inscriptionEntrepriseOuverte %}
                        <a href="{{ path('app_questionnaire_new', {'pro': 1}) }}" target="_blank" class="btn btn-action-dashboard h-50 d-flex align-items-center justify-content-center">
                            <i class="fas fa-briefcase me-2"></i> Accès formulaire professionnel·le·s
                        </a>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i> Aucune session n'est actuellement ouverte. Les données ci-dessous concernent la dernière session : <strong>{{ stats.sessionName }}</strong>.
            </div>
        {% endif %}
        {% include 'admin/_stats.html.twig' %}
    {% else %}
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i> Aucune session n'est disponible. Veuillez en créer une dans l'onglet "Sessions".
        </div>
    {% endif %}
{% endblock %}
