{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        @media print {
            body { background: white !important; font-size: 12pt; }
            .ea-wrapper { display: block !important; grid-template-columns: 1fr !important; }
            .ea-content-wrapper { margin-left: 0 !important; padding: 0 !important; }
            .content { margin: 0 !important; padding: 0 !important; }
            .ea-sidebar, .main-header, .content-header, .responsive-header, .content-top, .content-footer, .ea-detail-actions, .flash-messages, .ea-search-bar, .d-print-none, #flash-messages, .navbar, header { display: none !important; height: 0 !important; overflow: hidden !important; visibility: hidden !important; }
            .d-print-block { display: block !important; }
            .d-print-inline-block { display: inline-block !important; }
            .header-box { border: 1px solid #000; padding: 15px; margin-bottom: 20px; }
            .section-title { font-weight: bold; text-transform: uppercase; border-bottom: 2px solid #ccc; margin-bottom: 10px; padding-bottom: 5px; margin-top: 20px; }
            .title { font-weight: bold; text-transform: uppercase; margin-bottom: 10px; padding-bottom: 5px; margin-top: 20px; }
            .constraints-list { margin-top: 10px; }
            .constraints-list div { margin-bottom: 5px; }
            table.print-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
            table.print-table th, table.print-table td { border: 1px solid #000; padding: 8px; text-align: left; font-size: 12px; }
            table.print-table th { background-color: #f0f0f0; }
        }

        .table-secondary {
            background-color: #f8f9fa;
            opacity: 0.7;
        }

        .popover.constraint-popover {
            max-width: 300px;
        }
        .popover.constraint-popover .popover-header {
            background-color: #dc3545;
            color: white;
            border-bottom: 1px solid #bd2130;
        }
        .popover.constraint-popover .popover-body {
            background-color: #f8d7da;
            color: #721c24;
        }
        .popover.constraint-popover.bs-popover-start > .popover-arrow::before,
        .popover.constraint-popover.bs-popover-start > .popover-arrow::after {
            border-left-color: #f8d7da;
        }
        .popover.constraint-popover.bs-popover-start > .popover-arrow::before {
            border-left-color: #dc3545;
        }
    </style>
{% endblock %}

{% block detail_fields %}
    {% set matches = matches|default(app.request.attributes.get('matches')) %}
    {% set questionnaire = questionnaire|default(app.request.attributes.get('questionnaire')) %}
    {% set scoreRange = scoreRange|default(app.request.attributes.get('scoreRange')) %}

    {% if questionnaire is not null %}
        {% set is_participant = (questionnaire.type == 'participant') %}
        {% set is_pro = (questionnaire.type == 'employeur') %}
        {# Permissions logic: ROLE_REFERENT or higher allows editing matches #}
        {% set can_manage_matches = is_granted('ROLE_REFERENT') %}

        {% set existingMatches = questionnaire.appariements %}

        <div>
            <div class="d-print-none">
                {{ parent() }}
            </div>

            {% if existingMatches|length > 0 %}
                <div class="alert alert-success mb-4 d-print-none">
                    <h5 class="alert-heading"><i class="fas fa-check-circle me-2"></i> Immersion(s) prévue(s)</h5>
                    <ul class="list-group list-group-flush mt-2" style="background: transparent;">
                        {% for match in existingMatches %}
                            <li class="list-group-item d-flex justify-content-between align-items-center" style="background: transparent; padding-left: 0; padding-right: 0;">
                                <span>{{ match }}</span>
                                {% if can_manage_matches %}
                                    <a href="{{ path('admin_questionnaire_unmatch', {id: match.id}) }}" class="btn btn-danger action-delete js-confirm-unmatch">
                                        <i class="fas fa-unlink me-1"></i> Annuler
                                    </a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="d-none d-print-block">
                {% if not is_pro %}
                    <h1 class="text-center mb-4">Fiche VOLONTAIRE</h1>
                    <div class="header-box">
                        <div class="row">
                            <div class="col-6">
                                <p><strong>Nom :</strong> {{ questionnaire.contact.nomFamille }}</p>
                                <p><strong>Prénom :</strong> {{ questionnaire.contact.prenom }}</p>
                                <p><strong>Age :</strong> {{ questionnaire.contact.trancheAge }}</p>
                            </div>
                            <div class="col-6">
                                <p><strong>Situation :</strong> {{ questionnaire.contact.situation }}</p>
                                <p><strong>Commune de résidence :</strong> {{ questionnaire.contact.commune }}</p>
                            </div>
                            {% if questionnaire.contact.referent %}
                                <p><strong>Référent·e :</strong> {{ questionnaire.contact.referent.prenom }} {{ questionnaire.contact.referent.nomFamille }}{% if questionnaire.contact.referent.fonction %} — {{ questionnaire.contact.referent.fonction }}{% endif %}{% if questionnaire.contact.referent.structure %} ({{ questionnaire.contact.referent.structure }}){% endif %}</p>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <h3 class="text-center mb-4">Fiche EMPLOYEUR</h3>
                    <div class="header-box">
                        <div class="row">
                            <div class="col-6">
                                <p><strong>Structure :</strong> {{ questionnaire.contact.nomEntreprise }}</p>
                                <p><strong>Métier proposé :</strong> {{ questionnaire.metier }}</p>
                                <p><strong>Commune :</strong> {{ questionnaire.contact.commune }}</p>
                            </div>
                            <div class="col-6">
                                <p><strong>Représentant Structure :</strong> {{ questionnaire.contact.prenom }} {{ questionnaire.contact.nomFamille }}{% if questionnaire.contact.fonctionSignataire %} — {{ questionnaire.contact.fonctionSignataire }}{% endif %}</p>
                                <p><strong>Tuteur ou tutrice :</strong> {{ questionnaire.contact.prenomTuteur }} {{ questionnaire.contact.nomFamilleTuteur }}{% if questionnaire.contact.fonctionTuteur %} — {{ questionnaire.contact.fonctionTuteur }}{% endif %}</p>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <h3 class="section-title">Informations renseignées</h3>
                <div class="constraints-list">
                    {% set questions_schema = questionnaire.session.modelQuestionnaire.questionsDisposition.questions|default([]) %}
                    {% set user_responses = questionnaire.reponsesDisposition|default({}) %}
                    {% set date_question_index = null %}
                    {% set date_answers = [] %}

                    {% for index, question in questions_schema %}
                        {% if question.type_reponse|default('') == 'choix dates multiples' %}
                            {% set date_question_index = index %}
                            {% set key = 'question_' ~ index %}
                            {% set raw_dates = user_responses[key]|default([]) %}
                            {% if raw_dates is iterable %}
                                {% set date_answers = raw_dates %}
                            {% else %}
                                {% set date_answers = [raw_dates] %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}

                    {% for index, question in questions_schema %}
                        {% if index != date_question_index %}
                            {% set key = 'question_' ~ index %}
                            {% set answer_value = user_responses[key]|default(null) %}

                            {% set answer_label = '' %}
                            {% if question.reponses_possibles is defined %}
                                {% set found_labels = [] %}
                                {% for option in question.reponses_possibles %}
                                    {% set opt_libelle = is_pro
                                        ? option.libelle_employeur|default(option.libelle|default(''))
                                        : option.libelle_participant|default(option.libelle|default('')) %}
                                    {% if answer_value is iterable %}
                                        {% for val in answer_value %}
                                            {% if option.valeur ~ '' == val ~ '' %}
                                                {% set found_labels = found_labels|merge([opt_libelle]) %}
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        {% if option.valeur ~ '' == answer_value ~ '' %}
                                            {% set found_labels = found_labels|merge([opt_libelle]) %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                                {% set answer_label = found_labels|join(', ') %}
                            {% elseif question.type_reponse|default('') == 'réponse libre' %}
                                {% set answer_label = answer_value %}
                            {% endif %}

                            {% if answer_value is not null and answer_label is not empty %}
                                <div>
                                    <strong>{{ is_pro ? question.label_employeur : question.label_participant }} </strong> {{ answer_label }}
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                    <p><strong>{{ is_pro ? 'Dates proposées :' : 'Disponibilités :'  }}</strong>
                        {% for date_str in date_answers %}
                            {% if date_str is not empty %}
                                {{ date_str|date('d/m') }}{% if not loop.last %}, {% endif %}
                            {% endif %}
                        {% endfor %}
                    </p>
                </div>
            </div>

            {# This entire block containing matches will be hidden in print thanks to d-print-none #}
            <div class="field-group">
                <div class="field-value">
                    {% if matches is empty %}
                        <span class="text-muted">Aucune correspondance trouvée pour le moment.</span>
                    {% else %}
                        {% set has_any_mismatches = false %}
                        {% for match in matches %}
                            {% if match.constraintMismatches|default([])|length > 0 %}
                                {% set has_any_mismatches = true %}
                            {% endif %}
                        {% endfor %}

                        <div class="mb-3 mt-4 d-flex justify-content-between align-items-center">
                            <h3 class="section-title">Liste des profils les plus compatibles</h3>
                            <div class="d-flex gap-2 d-print-none">
                                <button type="button" class="btn btn-secondary js-print-scores">
                                    <i class="fas fa-chart-column me-1"></i> Analyse des scores
                                </button>
                                {% if existingMatches|length > 0 %}
                                    <button type="button" class="btn btn-primary js-print-immersion-sheet">
                                        <i class="fas fa-handshake me-1"></i> Fiche immersion
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                        {% set min_score = scoreRange.min ?? null %}
                        {% set max_score = scoreRange.max ?? null %}
                        <div class="d-flex gap-3 mb-3">
                            <span>Compatibilité min :
                                {% if min_score is null %}<span class="text-muted">-</span>
                                {% elseif min_score >= 75 %}<span class="badge badge-success">{{ min_score }}%</span>
                                {% elseif min_score >= 50 %}<span class="badge badge-warning">{{ min_score }}%</span>
                                {% else %}<span class="badge badge-danger">{{ min_score }}%</span>
                                {% endif %}
                            </span>
                            <span>Compatibilité max :
                                {% if max_score is null %}<span class="text-muted">-</span>
                                {% elseif max_score >= 75 %}<span class="badge badge-success">{{ max_score }}%</span>
                                {% elseif max_score >= 50 %}<span class="badge badge-warning">{{ max_score }}%</span>
                                {% else %}<span class="badge badge-danger">{{ max_score }}%</span>
                                {% endif %}
                            </span>
                        </div>
                        <div class="datagrid">
                            <div class="datagrid-body">
                                <table class="table table-sm table-hover">
                                    <thead>
                                    <tr>
                                        {% if is_participant %}
                                            <th class="text-center">Entreprise</th>
                                            <th class="text-center">Métier proposé</th>
                                            <th class="text-center">Contact</th>
                                        {% else %}
                                            <th class="text-center">Nom</th>
                                            <th class="text-center">Tranche d'âge</th>
                                        {% endif %}
                                        <th class="text-center d-print-none">Mail</th>
                                        <th class="text-center d-print-none">Téléphone</th>
                                        <th class="text-center">Compatibilité</th>
                                        <th class="text-center">Dates</th>
                                        {% if has_any_mismatches %}
                                            <th class="text-center">Contraintes</th>
                                        {% endif %}
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for match in matches %}
                                        <tr class="{{ match.isMatchedWithCurrent ? 'table-secondary' : '' }}" {% if match.isMatchedWithCurrent %}style="color: #6c757d;"{% endif %}>
                                            {% if is_participant %}
                                                <td>{{ match.entreprise|default('non précisée') }}</td>
                                                <td>{{ match.job|default('non précisé') }}</td>
                                                <td><a href="{{ match.detailUrl }}" class="d-print-none">{{ match.name }}</a><span class="d-none d-print-inline">{{ match.name }}</span></td>
                                            {% else %}
                                                <td><a href="{{ match.detailUrl }}" class="d-print-none">{{ match.label }}</a><span class="d-none d-print-inline">{{ match.label }}</span></td>
                                                <td class="text-center">{{ match.trancheAge }}</td>
                                            {% endif %}
                                            <td class="text-center d-print-none">{{ match.email }}</td>
                                            <td class="text-center d-print-none">{{ match.phone }}</td>
                                            <td class="text-center">
                                                {% if match.score >= 75 %}<span class="badge badge-success">{{ match.score }}%</span>
                                                {% elseif match.score >= 50 %}<span class="badge badge-warning">{{ match.score }}%</span>
                                                {% else %}<span class="badge badge-danger">{{ match.score }}%</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if match.compatibleDates %}
                                                    {% set has_available_dates = false %}
                                                    {% for dateData in match.compatibleDates %}
                                                        {% if dateData.isAvailable and not match.isMatchedWithCurrent %}
                                                            {% set has_available_dates = true %}
                                                            {% if can_manage_matches %}
                                                                <a href="{{ dateData.url }}" class="text-decoration-none" title="Ajouter l'immersion pour cette date">
                                                                    <span class="badge badge-success mb-1 cursor-pointer">
                                                                        <i class="fas fa-link me-1 d-print-none"></i> {{ dateData.label }}
                                                                    </span>
                                                                </a>
                                                            {% else %}
                                                                <span class="badge badge-success mb-1" style="opacity: 0.8; cursor: default;">
                                                                    {{ dateData.label }}
                                                                </span>
                                                            {% endif %}
                                                        {% else %}
                                                            <span class="badge badge-warning mb-1 d-print-none" title="{{ match.isMatchedWithCurrent ? 'Une immersion est déjà prévue' : dateData.reason }}" style="cursor: not-allowed; opacity: 0.6;">
                                                                {{ dateData.label }}
                                                            </span>
                                                        {% endif %}
                                                    {% endfor %}

                                                    {% if not has_available_dates %}
                                                        <span class="badge {{ match.isMatchedWithCurrent ? 'badge-success' : 'badge-warning' }} mb-1 d-none d-print-inline-block">{{ match.isMatchedWithCurrent ? 'Immersion prévue' : 'Incompatible' }}</span>
                                                    {% endif %}
                                                {% else %}
                                                    <span class="badge badge-warning mb-1">Indisponible</span>
                                                {% endif %}
                                            </td>
                                            {% if has_any_mismatches %}
                                                <td class="text-center">
                                                    {% if match.constraintMismatches|default([])|length > 0 %}
                                                        {% set mismatch_html %}
                                                            <ul class="mb-0 ps-3">
                                                                {% for mismatch in match.constraintMismatches %}
                                                                    <li>{{ mismatch }}</li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endset %}
                                                        <span class="badge badge-danger"
                                                              style="cursor: pointer;"
                                                              data-bs-toggle="popover"
                                                              data-bs-placement="left"
                                                              data-bs-trigger="hover focus"
                                                              data-bs-html="true"
                                                              data-bs-title="Contraintes limitantes immersion"
                                                              data-bs-content="{{ mismatch_html|escape('html_attr') }}">
                                                            <i class="fas fa-exclamation-triangle"></i> {{ match.constraintMismatches|length }}
                                                        </span>
                                                    {% endif %}
                                                </td>
                                            {% endif %}
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {#
                SANDBOXED PRINT EXPORT — DO NOT ADD `|raw` or inline event handlers
                (onclick=, onload=, etc.) inside this block.

                printImmersionSheet() reads this subtree's innerHTML and writes it
                into an iframe via doc.write(). Twig autoescape currently keeps the
                content safe, but any `|raw` or inline JS handler would re-execute
                on print. New content here must rely on autoescape only.
            #}
            {% if existingMatches|length > 0 %}
                <div id="fiche-immersion-print" style="display:none;">
                    <div class="page-header">
                        <h2>Fiche Immersion</h2>
                        <div class="subtitle">{{ questionnaire.session.nom|default('') }}</div>
                    </div>

                    {# Current profile block — shown once #}
                    <div class="immersion-card profile-card">
                        {% if not is_pro %}
                            <div class="card-header"><span class="party">Informations volontaire</span></div>
                            <div class="card-body">
                                <p class="card-section">Volontaire</p>
                                <p><strong>Nom :</strong> {{ questionnaire.contact.prenom }} {{ questionnaire.contact.nomFamille }}</p>
                                <p><strong>Email :</strong> {{ questionnaire.contact.email }}</p>
                                {% if questionnaire.contact.numeroTelephone %}<p><strong>Téléphone :</strong> {{ questionnaire.contact.numeroTelephone }}</p>{% endif %}
                                {% if questionnaire.contact.commune %}<p><strong>Commune :</strong> {{ questionnaire.contact.commune }}</p>{% endif %}
                                {% if questionnaire.contact.situation %}<p><strong>Situation :</strong> {{ questionnaire.contact.situation }}</p>{% endif %}

                                {% if questionnaire.contact.referent %}
                                    <p class="card-section">Référent·e</p>
                                    <p><strong>Nom :</strong> {{ questionnaire.contact.referent.prenom }} {{ questionnaire.contact.referent.nomFamille }}{% if questionnaire.contact.referent.fonction %} — {{ questionnaire.contact.referent.fonction }}{% endif %}{% if questionnaire.contact.referent.structure %} ({{ questionnaire.contact.referent.structure }}){% endif %}</p>
                                    {% if questionnaire.contact.referent.email %}<p><strong>Email :</strong> {{ questionnaire.contact.referent.email }}</p>{% endif %}
                                    {% if questionnaire.contact.referent.telephone %}<p><strong>Téléphone :</strong> {{ questionnaire.contact.referent.telephone }}</p>{% endif %}
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="card-header"><span class="party">Structure d'accueil</span></div>
                            <div class="card-body">
                                <p class="card-section">Structure</p>
                                {% if questionnaire.contact.nomEntreprise %}<p><strong>Entreprise :</strong> {{ questionnaire.contact.nomEntreprise }}</p>{% endif %}
                                {% if questionnaire.contact.secteurActivite %}<p><strong>Secteur d'activité :</strong> {{ questionnaire.contact.secteurActivite }}</p>{% endif %}
                                {% if questionnaire.contact.nombreEmployes %}<p><strong>Effectif :</strong> {{ questionnaire.contact.nombreEmployes }}</p>{% endif %}
                                {% if questionnaire.contact.siret %}<p><strong>SIRET :</strong> {{ questionnaire.contact.siret }}</p>{% endif %}
                                {% if questionnaire.contact.commune %}<p><strong>Commune :</strong> {{ questionnaire.contact.commune }}</p>{% endif %}
                                {% if questionnaire.contact.adresseEntreprise %}<p><strong>Adresse :</strong> {{ questionnaire.contact.adresseEntreprise }}</p>{% endif %}
                                {% if questionnaire.metier %}<p><strong>Métier proposé :</strong> {{ questionnaire.metier }}</p>{% endif %}

                                <p class="card-section">Représentant Structure</p>
                                <p><strong>Nom :</strong> {{ questionnaire.contact.prenom }} {{ questionnaire.contact.nomFamille }}{% if questionnaire.contact.fonctionSignataire %} — {{ questionnaire.contact.fonctionSignataire }}{% endif %}</p>
                                <p><strong>Email :</strong> {{ questionnaire.contact.email }}</p>
                                {% if questionnaire.contact.numeroTelephone %}<p><strong>Téléphone :</strong> {{ questionnaire.contact.numeroTelephone }}</p>{% endif %}

                                <p class="card-section">Tuteur ou tutrice</p>
                                <p><strong>Nom :</strong> {{ questionnaire.contact.prenomTuteur }} {{ questionnaire.contact.nomFamilleTuteur }}{% if questionnaire.contact.fonctionTuteur %} — {{ questionnaire.contact.fonctionTuteur }}{% endif %}</p>
                                {% if questionnaire.contact.emailTuteur %}<p><strong>Email :</strong> {{ questionnaire.contact.emailTuteur }}</p>{% endif %}
                                {% if questionnaire.contact.telephoneTuteur %}<p><strong>Téléphone :</strong> {{ questionnaire.contact.telephoneTuteur }}</p>{% endif %}

                                <p class="card-section">Conditions d'accueil</p>
                                {% if questionnaire.immersionMemeDate %}<p><strong>Plusieurs immersions le même jour :</strong> Oui</p>{% endif %}
                                {% if questionnaire.contact.horaires %}<p><strong>Horaires :</strong> {{ questionnaire.contact.horaires }}</p>{% endif %}
                                {% if questionnaire.contact.epiDisponible is not null %}<p><strong>EPI disponible :</strong> {{ questionnaire.contact.epiDisponible ? 'Oui' : 'Non' }}</p>{% endif %}
                                {% if questionnaire.contact.autresMesuresPrevention %}<p><strong>Mesures de prévention :</strong> {{ questionnaire.contact.precisionMesuresPrevention }}</p>{% endif %}
                            </div>
                        {% endif %}
                    </div>

                    {# One card per booked immersion — only the other party's info + date #}
                    {% for appariement in existingMatches|sort((a, b) => a.dateMatch <=> b.dateMatch) %}
                        {% if not is_pro %}
                            {% set other_contact = appariement.entreprise.contact %}
                            {% set other_metier = appariement.entreprise.metier %}
                        {% else %}
                            {% set other_contact = appariement.participant.contact %}
                            {% set other_metier = null %}
                        {% endif %}
                        <div class="immersion-card">
                            <div class="card-header">
                                <span class="party">{{ not is_pro ? 'Professionnel·le' : 'Volontaire' }}</span>
                                <span class="date">Immersion le {{ appariement.dateMatch ? appariement.dateMatch|date('d/m/Y') : 'date non précisée' }}</span>
                            </div>
                            <div class="card-body">
                                {% if not is_pro %}
                                    <p class="card-section">Structure</p>
                                    {% if other_contact.nomEntreprise %}<p><strong>Entreprise :</strong> {{ other_contact.nomEntreprise }}</p>{% endif %}
                                    {% if other_contact.siret %}<p><strong>SIRET :</strong> {{ other_contact.siret }}</p>{% endif %}
                                    {% if other_contact.commune %}<p><strong>Commune :</strong> {{ other_contact.commune }}</p>{% endif %}
                                    {% if other_contact.adresseEntreprise %}<p><strong>Adresse :</strong> {{ other_contact.adresseEntreprise }}</p>{% endif %}
                                    {% if other_metier %}<p><strong>Métier proposé :</strong> {{ other_metier }}</p>{% endif %}

                                    <p class="card-section">Représentant Structure</p>
                                    <p><strong>Nom :</strong> {{ other_contact.prenom }} {{ other_contact.nomFamille }}{% if other_contact.fonctionSignataire %} — {{ other_contact.fonctionSignataire }}{% endif %}</p>
                                    <p><strong>Email :</strong> {{ other_contact.email }}</p>
                                    {% if other_contact.numeroTelephone %}<p><strong>Téléphone :</strong> {{ other_contact.numeroTelephone }}</p>{% endif %}

                                    <p class="card-section">Tuteur ou tutrice</p>
                                    <p><strong>Nom :</strong> {{ other_contact.prenomTuteur }} {{ other_contact.nomFamilleTuteur }}{% if other_contact.fonctionTuteur %} — {{ other_contact.fonctionTuteur }}{% endif %}</p>
                                    {% if other_contact.emailTuteur %}<p><strong>Email :</strong> {{ other_contact.emailTuteur }}</p>{% endif %}
                                    {% if other_contact.telephoneTuteur %}<p><strong>Téléphone :</strong> {{ other_contact.telephoneTuteur }}</p>{% endif %}

                                    <p class="card-section">Conditions d'accueil</p>
                                    {% if appariement.entreprise.immersionMemeDate %}<p><strong>Plusieurs immersions le même jour :</strong> Oui</p>{% endif %}
                                    {% if other_contact.horaires %}<p><strong>Horaires :</strong> {{ other_contact.horaires }}</p>{% endif %}
                                    {% if other_contact.epiDisponible is not null %}<p><strong>EPI disponible :</strong> {{ other_contact.epiDisponible ? 'Oui' : 'Non' }}</p>{% endif %}
                                    {% if other_contact.autresMesuresPrevention %}<p><strong>Mesures de prévention :</strong> {{ other_contact.precisionMesuresPrevention }}</p>{% endif %}
                                {% else %}
                                    <p class="card-section">Volontaire</p>
                                    <p><strong>Nom :</strong> {{ other_contact.prenom }} {{ other_contact.nomFamille }}</p>
                                    <p><strong>Email :</strong> {{ other_contact.email }}</p>
                                    {% if other_contact.numeroTelephone %}<p><strong>Téléphone :</strong> {{ other_contact.numeroTelephone }}</p>{% endif %}
                                    {% if other_contact.commune %}<p><strong>Commune :</strong> {{ other_contact.commune }}</p>{% endif %}
                                    {% if other_contact.situation %}<p><strong>Situation :</strong> {{ other_contact.situation }}</p>{% endif %}

                                    {% if other_contact.referent %}
                                        <p class="card-section">Référent·e</p>
                                        <p><strong>Nom :</strong> {{ other_contact.referent.prenom }} {{ other_contact.referent.nomFamille }}{% if other_contact.referent.fonction %} — {{ other_contact.referent.fonction }}{% endif %}{% if other_contact.referent.structure %} ({{ other_contact.referent.structure }}){% endif %}</p>
                                        {% if other_contact.referent.email %}<p><strong>Email :</strong> {{ other_contact.referent.email }}</p>{% endif %}
                                        {% if other_contact.referent.telephone %}<p><strong>Téléphone :</strong> {{ other_contact.referent.telephone }}</p>{% endif %}
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl, {
                    customClass: 'constraint-popover'
                });
            });

            document.querySelectorAll('.js-confirm-unmatch').forEach(function(el) {
                el.addEventListener('click', function(e) {
                    if (!window.confirm('Êtes-vous sûr de vouloir annuler cette immersion ?')) {
                        e.preventDefault();
                    }
                });
            });
            document.querySelectorAll('.js-print-scores').forEach(function(el) {
                el.addEventListener('click', function() { window.print(); });
            });
            document.querySelectorAll('.js-print-immersion-sheet').forEach(function(el) {
                el.addEventListener('click', printImmersionSheet);
            });
        });

        function printImmersionSheet() {
            const content = document.getElementById('fiche-immersion-print').innerHTML;
            const iframe = document.createElement('iframe');
            iframe.style.cssText = 'position:fixed;top:0;left:0;width:0;height:0;border:0;';
            document.body.appendChild(iframe);
            const doc = iframe.contentWindow.document;
            doc.open();
            doc.write(`<!DOCTYPE html><html lang="fr"><head>
                <meta charset="UTF-8">
                <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&display=swap" rel="stylesheet">
                <style>
                    * { box-sizing: border-box; margin: 0; padding: 0; }
                    body { font-family: 'Barlow', Arial, sans-serif; font-size: 11pt; color: #1a1a1a; background: white; padding: 32px 44px; }

                    .page-header { text-align: center; border-bottom: 3px solid #1a1a1a; padding-bottom: 16px; margin-bottom: 28px; }
                    .page-header h2 { font-size: 20pt; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 4px; }
                    .page-header .subtitle { font-size: 10pt; color: #555; font-style: italic; }

                    .immersion-card { border: 1px solid #c8c8c8; border-radius: 4px; margin-bottom: 16px; page-break-inside: avoid; overflow: hidden; }
                    .profile-card { border: 2px solid #0a1f3d; border-radius: 4px; background: #f0f4f9; margin-bottom: 32px; }
                    .card-header { padding: 11px 18px; background: #000; color: white; display: flex; justify-content: space-between; align-items: center; }
                    .profile-card .card-header { background: #1e3a5f; padding: 12px 18px; }
                    .card-header .party { font-size: 13pt; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
                    .card-header .date { font-size: 12pt; font-weight: 700; }
                    .card-body { padding: 16px 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; }

                    .card-body p { margin: 0; padding: 3px 0; font-size: 11pt; line-height: 1.5; }
                    .card-section { grid-column: 1 / -1; font-size: 8.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: #666; border-bottom: 1px solid #ddd; padding-bottom: 3px; margin-top: 12px; }
                    .card-section:first-child { margin-top: 0; }
                </style>
            </head><body>${content}</body></html>`);
            doc.close();
            iframe.contentWindow.focus();
            iframe.contentWindow.print();
            setTimeout(() => document.body.removeChild(iframe), 1000);
        }
    </script>
{% endblock %}
