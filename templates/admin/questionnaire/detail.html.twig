{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        @media print {
            body { background: white !important; font-size: 12pt; }
            .ea-wrapper { display: block !important; grid-template-columns: 1fr !important; }
            .ea-content-wrapper { margin-left: 0 !important; padding: 0 !important; }
            .content { margin: 0 !important; padding: 0 !important; }
            .ea-sidebar, .main-header, .content-header, .responsive-header, .content-top, .content-footer, .ea-detail-actions, .flash-messages, .ea-search-bar, .d-print-none, #flash-messages, .navbar, header { display: none !important; height: 0 !important; overflow: hidden !important; visibility: hidden !important; }
            .d-print-block { display: block !important; }
            .d-print-inline-block { display: inline-block !important; }
            .header-box { border: 1px solid #000; padding: 15px; margin-bottom: 20px; }
            .section-title { font-weight: bold; text-transform: uppercase; border-bottom: 2px solid #ccc; margin-bottom: 10px; padding-bottom: 5px; margin-top: 20px; }
            .title { font-weight: bold; text-transform: uppercase; margin-bottom: 10px; padding-bottom: 5px; margin-top: 20px; }
            .constraints-list { margin-top: 10px; }
            .constraints-list div { margin-bottom: 5px; }
            table.print-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
            table.print-table th, table.print-table td { border: 1px solid #000; padding: 8px; text-align: left; font-size: 12px; }
            table.print-table th { background-color: #f0f0f0; }
        }

        .table-secondary {
            background-color: #f8f9fa;
            opacity: 0.7;
        }

        .popover.constraint-popover {
            max-width: 300px;
        }
        .popover.constraint-popover .popover-header {
            background-color: #dc3545;
            color: white;
            border-bottom: 1px solid #bd2130;
        }
        .popover.constraint-popover .popover-body {
            background-color: #f8d7da;
            color: #721c24;
        }
        .popover.constraint-popover.bs-popover-start > .popover-arrow::before,
        .popover.constraint-popover.bs-popover-start > .popover-arrow::after {
            border-left-color: #f8d7da;
        }
        .popover.constraint-popover.bs-popover-start > .popover-arrow::before {
            border-left-color: #dc3545;
        }
    </style>
{% endblock %}

{% block detail_fields %}
    {% set matches = matches|default(app.request.attributes.get('matches')) %}
    {% set questionnaire = questionnaire|default(app.request.attributes.get('questionnaire')) %}

    {% if questionnaire is not null %}
        {% set is_participant = (questionnaire.type == 'participant') %}
        {% set is_pro = (questionnaire.type == 'employeur') %}
        {# Permissions logic: ROLE_REFERENT or higher allows editing matches #}
        {% set can_manage_matches = is_granted('ROLE_REFERENT') %}

        {% set existingMatches = questionnaire.appariements %}

        <div>
            <div class="d-print-none">
                {{ parent() }}
            </div>

            {% if existingMatches|length > 0 %}
                <div class="alert alert-success mb-4 d-print-none">
                    <h5 class="alert-heading"><i class="fas fa-check-circle me-2"></i> Immersion(s) prévue(s)</h5>
                    <ul class="list-group list-group-flush mt-2" style="background: transparent;">
                        {% for match in existingMatches %}
                            <li class="list-group-item d-flex justify-content-between align-items-center" style="background: transparent; padding-left: 0; padding-right: 0;">
                                <span>{{ match }}</span>
                                {% if can_manage_matches %}
                                    <a href="{{ path('admin_questionnaire_unmatch', {id: match.id}) }}" class="btn btn-danger action-delete" onclick="return confirm('Êtes-vous sûr de vouloir annuler cette immersion ?')">
                                        <i class="fas fa-unlink me-1"></i> Annuler
                                    </a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="d-none d-print-block">
                {% if not is_pro %}
                    <h1 class="text-center mb-4">Fiche VOLONTAIRE</h1>
                    <div class="header-box">
                        <div class="row">
                            <div class="col-6">
                                <p><strong>Nom :</strong> {{ questionnaire.contact.nomFamille }}</p>
                                <p><strong>Prénom :</strong> {{ questionnaire.contact.prenom }}</p>
                                <p><strong>Age :</strong> {{ questionnaire.contact.trancheAge }}</p>
                            </div>
                            <div class="col-6">
                                <p><strong>Adresse mail :</strong> {{ questionnaire.contact.email }}</p>
                                <p><strong>Téléphone :</strong> {{ questionnaire.contact.numeroTelephone }}</p>
                                <p><strong>Situation :</strong> {{ questionnaire.contact.situation }}</p>
                            </div>
                            <p><strong>Commune de résidence :</strong> {{ questionnaire.contact.commune }}</p>
                        </div>
                    </div>
                {% else %}
                    <h3 class="text-center mb-4">Fiche EMPLOYEUR</h3>
                    <div class="header-box">
                        <div class="row">
                            <div class="col-6">
                                <p><strong>Structure :</strong> {{ questionnaire.contact.nomEntreprise }}</p>
                                <p><strong>Contact :</strong> {{ questionnaire.contact.prenom }} {{ questionnaire.contact.nomFamille }}</p>
                                <p><strong>Adresse :</strong> {{ questionnaire.contact.commune }}</p>
                            </div>
                            <div class="col-6">
                                <p><strong>Adresse mail :</strong> {{ questionnaire.contact.email }}</p>
                                <p><strong>Téléphone :</strong> {{ questionnaire.contact.numeroTelephone }}</p>
                            </div>
                        </div>
                        <div class="col-12">
                            <p><strong>Métier proposé à l'immersion :</strong> {{ questionnaire.metier }}</p>
                        </div>
                    </div>
                {% endif %}

                <h3 class="section-title">Informations renseignées</h3>
                <div class="constraints-list">
                    {% set questions_schema = questionnaire.session.modelQuestionnaire.questionsDisposition.questions|default([]) %}
                    {% set user_responses = questionnaire.reponsesDisposition|default({}) %}
                    {% set date_question_index = null %}
                    {% set date_answers = [] %}

                    {% for index, question in questions_schema %}
                        {% if question.type_reponse|default('') == 'choix dates multiples' %}
                            {% set date_question_index = index %}
                            {% set key = 'question_' ~ index %}
                            {% set raw_dates = user_responses[key]|default([]) %}
                            {% if raw_dates is iterable %}
                                {% set date_answers = raw_dates %}
                            {% else %}
                                {% set date_answers = [raw_dates] %}
                            {% endif %}
                        {% endif %}
                    {% endfor %}

                    {% for index, question in questions_schema %}
                        {% if index != date_question_index %}
                            {% set key = 'question_' ~ index %}
                            {% set answer_value = user_responses[key]|default(null) %}

                            {% set answer_label = '' %}
                            {% if question.reponses_possibles is defined %}
                                {% set found_labels = [] %}
                                {% for option in question.reponses_possibles %}
                                    {% if answer_value is iterable %}
                                        {% for val in answer_value %}
                                            {% if option.valeur ~ '' == val ~ '' %}
                                                {% set found_labels = found_labels|merge([option.libelle]) %}
                                            {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        {% if option.valeur ~ '' == answer_value ~ '' %}
                                            {% set found_labels = found_labels|merge([option.libelle]) %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                                {% set answer_label = found_labels|join(', ') %}
                            {% elseif question.type_reponse|default('') == 'réponse libre' %}
                                {% set answer_label = answer_value %}
                            {% endif %}

                            {% if answer_value is not null and answer_label is not empty %}
                                <div>
                                    <strong>{{ is_pro ? question.label_employeur : question.label_participant }} </strong> {{ answer_label }}
                                </div>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                    <p><strong>{{ is_pro ? 'Dates proposées :' : 'Disponibilités :'  }}</strong>
                        {% for date_str in date_answers %}
                            {% if date_str is not empty %}
                                {{ date_str|date('d/m') }}{% if not loop.last %}, {% endif %}
                            {% endif %}
                        {% endfor %}
                    </p>
                </div>
            </div>

            {# This entire block containing matches will be hidden in print thanks to d-print-none #}
            <div class="field-group">
                <div class="field-value">
                    {% if matches is empty %}
                        <span class="text-muted">Aucune correspondance trouvée pour le moment.</span>
                    {% else %}
                        {% set has_any_mismatches = false %}
                        {% for match in matches %}
                            {% if match.constraintMismatches|default([])|length > 0 %}
                                {% set has_any_mismatches = true %}
                            {% endif %}
                        {% endfor %}
                        
                        <div class="mb-3 mt-4 d-flex justify-content-between align-items-center">
                            <h3 class="section-title">Liste des profils les plus compatibles</h3>
                            <button onclick="window.print()" class="btn btn-secondary d-print-none">
                                <i class="fas fa-print me-1"></i> Exporter la fiche
                            </button>
                        </div>
                        {% set min_score = null %}
                        {% set max_score = null %}
                        {% for match in matches %}
                            {% if min_score is null or match.score < min_score %}
                                {% set min_score = match.score %}
                            {% endif %}
                            {% if max_score is null or match.score > max_score %}
                                {% set max_score = match.score %}
                            {% endif %}
                        {% endfor %}
                        <div class="d-flex gap-3 mb-3">
                            <span>Compatibilité min :
                                {% if min_score >= 75 %}<span class="badge badge-success">{{ min_score }}%</span>
                                {% elseif min_score >= 50 %}<span class="badge badge-warning">{{ min_score }}%</span>
                                {% else %}<span class="badge badge-danger">{{ min_score }}%</span>
                                {% endif %}
                            </span>
                            <span>Compatibilité max :
                                {% if max_score >= 75 %}<span class="badge badge-success">{{ max_score }}%</span>
                                {% elseif max_score >= 50 %}<span class="badge badge-warning">{{ max_score }}%</span>
                                {% else %}<span class="badge badge-danger">{{ max_score }}%</span>
                                {% endif %}
                            </span>
                        </div>
                        <div class="datagrid">
                            <div class="datagrid-body">
                                <table class="table table-sm table-hover">
                                    <thead>
                                    <tr>
                                        {% if is_participant %}
                                            <th class="text-center">Entreprise</th>
                                            <th class="text-center">Métier proposé</th>
                                            <th class="text-center">Contact</th>
                                        {% else %}
                                            <th class="text-center">Nom</th>
                                            <th class="text-center">Tranche d'âge</th>
                                        {% endif %}
                                        <th class="text-center">Mail</th>
                                        <th class="text-center">Téléphone</th>
                                        <th class="text-center">Compatibilité</th>
                                        <th class="text-center">Dates</th>
                                        {% if has_any_mismatches %}
                                            <th class="text-center">Contraintes</th>
                                        {% endif %}
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for match in matches %}
                                        <tr class="{{ match.isMatchedWithCurrent ? 'table-secondary d-print-none' : '' }}">
                                            {% if is_participant %}
                                                <td>{{ match.entreprise|default('non précisée') }}</td>
                                                <td>{{ match.job|default('non précisé') }}</td>
                                                <td><a href="{{ match.detailUrl }}">{{ match.name }}</a></td>
                                            {% else %}
                                                <td><a href="{{ match.detailUrl }}">{{ match.label }}</a></td>
                                                <td class="text-center">{{ match.trancheAge }}</td>
                                            {% endif %}
                                            <td class="text-center">{{ match.email }}</td>
                                            <td class="text-center">{{ match.phone }}</td>
                                            <td class="text-center">
                                                {% if match.score >= 75 %}<span class="badge badge-success">{{ match.score }}%</span>
                                                {% elseif match.score >= 50 %}<span class="badge badge-warning">{{ match.score }}%</span>
                                                {% else %}<span class="badge badge-danger">{{ match.score }}%</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if match.compatibleDates %}
                                                    {% set has_available_dates = false %}
                                                    {% for dateData in match.compatibleDates %}
                                                        {% if dateData.isAvailable and not match.isMatchedWithCurrent %}
                                                            {% set has_available_dates = true %}
                                                            {% if can_manage_matches %}
                                                                <a href="{{ dateData.url }}" class="text-decoration-none" title="Ajouter l'immersion pour cette date">
                                                                    <span class="badge badge-success mb-1 cursor-pointer">
                                                                        <i class="fas fa-link me-1 d-print-none"></i> {{ dateData.label }}
                                                                    </span>
                                                                </a>
                                                            {% else %}
                                                                <span class="badge badge-success mb-1" style="opacity: 0.8; cursor: default;">
                                                                    {{ dateData.label }}
                                                                </span>
                                                            {% endif %}
                                                        {% else %}
                                                            <span class="badge badge-warning mb-1 d-print-none" title="{{ match.isMatchedWithCurrent ? 'Une immersion est déjà prévue' : dateData.reason }}" style="cursor: not-allowed; opacity: 0.6;">
                                                                {{ dateData.label }}
                                                            </span>
                                                        {% endif %}
                                                    {% endfor %}

                                                    {% if not has_available_dates %}
                                                        <span class="badge badge-warning mb-1 d-none d-print-inline-block">Incompatible</span>
                                                    {% endif %}
                                                {% else %}
                                                    <span class="badge badge-warning mb-1">Indisponible</span>
                                                {% endif %}
                                            </td>
                                            {% if has_any_mismatches %}
                                                <td class="text-center">
                                                    {% if match.constraintMismatches|default([])|length > 0 %}
                                                        {% set mismatch_html %}
                                                            <ul class="mb-0 ps-3">
                                                                {% for mismatch in match.constraintMismatches %}
                                                                    <li>{{ mismatch }}</li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endset %}
                                                        <span class="badge badge-danger" 
                                                              style="cursor: pointer;"
                                                              data-bs-toggle="popover" 
                                                              data-bs-placement="left" 
                                                              data-bs-trigger="hover focus"
                                                              data-bs-html="true"
                                                              data-bs-title="Contraintes limitantes immersion"
                                                              data-bs-content="{{ mismatch_html|escape('html_attr') }}">
                                                            <i class="fas fa-exclamation-triangle"></i> {{ match.constraintMismatches|length }}
                                                        </span>
                                                    {% endif %}
                                                </td>
                                            {% endif %}
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'));
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl, {
                    customClass: 'constraint-popover'
                });
            });
        });
    </script>
{% endblock %}
