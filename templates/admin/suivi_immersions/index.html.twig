{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}Suivi des immersions{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        .suivi-toolbar { display: flex; flex-wrap: wrap; gap: .75rem; align-items: flex-end; margin-bottom: 1rem; }
        .suivi-toolbar .field { display: flex; flex-direction: column; gap: .25rem; }
        .suivi-toolbar label { font-size: .9rem; font-weight: 600; margin: 0; }
        /* Angles arrondis cohérents avec le récap et le tableau */
        .suivi-toolbar .form-select,
        .suivi-toolbar .form-control { border-radius: .5rem; }
        .suivi-recap { display: flex; flex-wrap: wrap; align-items: stretch; gap: .5rem 1rem;
            padding: .6rem .9rem; margin-bottom: 1rem; background: #fff; border: 1px solid #e5e7eb;
            border-radius: .6rem; font-size: .9rem; color: #334155; }
        .suivi-recap .recap-group { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.1rem; }
        .suivi-recap .recap-divider { width: 1px; align-self: stretch; background: #e5e7eb; margin: 0 .25rem; }
        .suivi-recap .recap-item { display: inline-flex; align-items: baseline; gap: .35rem; white-space: nowrap; }
        .suivi-recap .recap-item b { font-size: 1.15rem; font-weight: 700; color: var(--green-color, #2f6f4f); line-height: 1; }
        .suivi-recap .recap-item .label { color: #64748b; }
        /* Groupe « à traiter » : accent ambre sur un manque, neutre sinon */
        .suivi-recap .recap-item--gap b { color: #b45309; }
        .suivi-recap .recap-item--ok b { color: #15803d; }
        .suivi-recap .recap-item--muted b { color: #94a3b8; }
        .suivi-table-wrapper { max-height: calc(100vh - 320px); overflow: auto; border: 1px solid #dee2e6; border-radius: .5rem; }
        .suivi-table { margin: 0; font-size: .8rem; white-space: nowrap; }
        .suivi-table > :not(caption) > * > * { padding: .35rem .45rem; }
        .suivi-table thead th { position: sticky; top: 0; z-index: 2; background: #fff;
            box-shadow: inset 0 -2px 0 #dee2e6; cursor: pointer; user-select: none; }
        .suivi-table thead th.no-sort { cursor: default; }
        .suivi-table thead th .arrow { margin-left: .3rem; font-size: .72rem; opacity: .35; }
        .suivi-table thead th[data-dir] .arrow { opacity: 1; color: var(--green-color, #2f6f4f); }
        .suivi-table tbody tr.is-phantom { background: #fff8e6; }
        /* Colonnes texte longues tronquées (valeur complète au survol via title) */
        .suivi-table td.cell-ell { max-width: 130px; overflow: hidden; text-overflow: ellipsis; }
        /* Les liens (Volontaire/Entreprise/Mail) doivent tronquer eux-mêmes, sinon ils
           élargissent la colonne et déclenchent un scroll horizontal */
        .suivi-table td.cell-ell a { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
        .suivi-table td.obs { max-width: 200px; overflow: hidden; text-overflow: ellipsis; }
        .suivi-table td.js-editable { white-space: normal; min-width: 90px; cursor: text; }
        .suivi-table td.js-editable:focus { outline: 2px solid var(--green-color, #4a7); background: #fff; overflow: visible; }
        .suivi-table td.js-editable:empty::before { content: '—'; color: #adb5bd; }
        .suivi-table .js-statut { width: auto; min-width: 96px; font-size: .78rem; border-radius: .5rem; }
        /* « Proposée » (seul statut en secondary) : gris plus clair, texte foncé lisible */
        .suivi-table .js-statut.bg-secondary { background-color: #e9ecef !important; color: #495057 !important; }
        .suivi-table td .saved-flash { color: #198754; font-weight: 600; }
        .suivi-table td .error-flash { color: #b02a37; font-weight: 600; }
        .suivi-empty { padding: 2rem; text-align: center; color: #6c757d; }
    </style>
{% endblock %}

{% block main %}
    {% if session is null %}
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i> Aucune session sélectionnée ou ouverte.
        </div>
    {% else %}
        {# --- Barre de filtres (serveur, form GET) ---
           On soumet via la route du dashboard EasyAdmin (`/admin`) avec `routeName` en
           champ caché, et non vers la route brute `/admin/suivi-immersions` : cette
           dernière ne reconstruit pas l'AdminContext (`ea`) une fois le dashboard servi
           (worker mode) → HTTP 500 dans le layout EA. Passer par `/admin?routeName=…`
           reproduit le lien du menu (linkToRoute) : `ea` est construit et les filtres
           GET sont transmis au contrôleur. NB : un form GET écrase la query string de
           `action`, d'où le champ caché plutôt qu'un param dans l'URL. #}
        <form method="get" action="{{ path('admin') }}" class="suivi-toolbar">
            <input type="hidden" name="routeName" value="admin_suivi_immersions">
            <div class="field">
                <label for="f-session">Session</label>
                <select id="f-session" name="session" class="form-select form-select-sm" onchange="this.form.submit()">
                    {% for s in sessions %}
                        <option value="{{ s.id }}" {{ s.id == session.id ? 'selected' }}>{{ s.nom }}{{ s.statut == 'ouverte' ? ' (ouverte)' }}</option>
                    {% endfor %}
                </select>
            </div>

            {% if isAdmin %}
                <div class="field">
                    <label for="f-referent">Référent·e</label>
                    <select id="f-referent" name="referent" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">Tous</option>
                        {% for r in referents %}
                            <option value="{{ r.id }}" {{ r.id == selectedReferentId ? 'selected' }}>{{ r.prenom }} {{ r.nomFamille }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}

            <div class="field">
                <label for="f-statut">Statut</label>
                <select id="f-statut" class="form-select form-select-sm js-filter-statut">
                    <option value="">Tous</option>
                    {% for statut in statutChoices %}
                        <option value="{{ statut.value }}">{{ statut.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="field">
                <label for="f-search">Recherche</label>
                <input id="f-search" type="search" class="form-control form-control-sm js-search" placeholder="Nom, entreprise, métier…">
            </div>

            <div class="field">
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="f-phantom" name="sansImmersion" value="1"
                           {{ showPhantom ? 'checked' }} onchange="this.form.submit()">
                    <label class="form-check-label" for="f-phantom">Volontaires sans immersion</label>
                </div>
            </div>
        </form>

        {# --- Bandeau récap : inventaire (gauche) | à suivre (droite) --- #}
        {% if recap %}
            <div class="suivi-recap">
                <div class="recap-group">
                    <span class="recap-item"><b>{{ recap.volontaires }}</b> <span class="label">volontaire{{ recap.volontaires > 1 ? 's' }}</span></span>
                    <span class="recap-item"><b>{{ recap.immersions }}</b> <span class="label">immersion{{ recap.immersions > 1 ? 's' }}</span></span>
                    <span class="recap-item"><b>{{ recap.entreprisesAvecImmersion }}</b> <span class="label">entreprise{{ recap.entreprisesAvecImmersion > 1 ? 's' }} engagée{{ recap.entreprisesAvecImmersion > 1 ? 's' }}</span></span>
                </div>

                <span class="recap-divider" aria-hidden="true"></span>

                <div class="recap-group">
                    <span class="recap-item {{ recap.volontairesSansImmersion > 0 ? 'recap-item--gap' : 'recap-item--ok' }}">
                        <b>{{ recap.volontairesSansImmersion }}</b> <span class="label">volontaire{{ recap.volontairesSansImmersion > 1 ? 's' }} sans immersion</span>
                    </span>
                    {% if recap.entreprisesDisponibles is not null %}
                        <span class="recap-item {{ recap.entreprisesDisponibles == 0 ? 'recap-item--muted' }}">
                            <b>{{ recap.entreprisesDisponibles }}</b> <span class="label">entreprise{{ recap.entreprisesDisponibles > 1 ? 's' }} disponible{{ recap.entreprisesDisponibles > 1 ? 's' }} pour immersion</span>
                        </span>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {# --- Tableau --- #}
        <div class="suivi-table-wrapper">
            <table class="table table-hover table-sm suivi-table js-suivi-table">
                <thead>
                    <tr>
                        <th data-type="text">Volontaire <i class="fas fa-sort arrow"></i></th>
                        <th data-type="text">Commune <i class="fas fa-sort arrow"></i></th>
                        <th data-type="text">Situation <i class="fas fa-sort arrow"></i></th>
                        <th data-type="text">Référent·e <i class="fas fa-sort arrow"></i></th>
                        <th data-type="text">Entreprise <i class="fas fa-sort arrow"></i></th>
                        <th data-type="text">Métier <i class="fas fa-sort arrow"></i></th>
                        <th data-type="date">Date <i class="fas fa-sort arrow"></i></th>
                        <th data-type="text">Statut <i class="fas fa-sort arrow"></i></th>
                        <th data-type="text">Mail <i class="fas fa-sort arrow"></i></th>
                        <th class="no-sort">Tél.</th>
                        <th data-type="num">Score <i class="fas fa-sort arrow"></i></th>
                        <th class="no-sort">Observations</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr class="{{ row.isPhantom ? 'is-phantom' }}"
                            data-statut="{{ row.isPhantom ? 'none' : row.statut.value }}">
                            <td class="cell-ell" data-sort="{{ row.volontaire|lower }}" title="{{ row.volontaire }}">
                                {% if row.volontaireUrl %}<a href="{{ row.volontaireUrl }}">{{ row.volontaire }}</a>{% else %}{{ row.volontaire }}{% endif %}
                            </td>
                            <td class="cell-ell" title="{{ row.commune }}">{{ row.commune ?? '—' }}</td>
                            <td class="cell-ell" title="{{ row.situation }}">{{ row.situation ?? '—' }}</td>
                            <td class="cell-ell" title="{{ row.referent }}">{{ row.referent ?? '—' }}</td>
                            <td class="cell-ell" data-sort="{{ row.entreprise|lower }}">
                                {% if row.entrepriseUrl %}<a href="{{ row.entrepriseUrl }}" title="{{ row.entreprise }}">{{ row.entreprise }}</a>{% else %}—{% endif %}
                            </td>
                            <td class="cell-ell" title="{{ row.metier }}">{{ row.metier ?? '—' }}</td>
                            <td data-sort="{{ row.date ? row.date|date('Y-m-d') : '' }}">{{ row.date ? row.date|date('d/m/Y') : '—' }}</td>
                            <td>
                                {% if row.isPhantom %}
                                    <span class="badge bg-light text-dark border">Sans immersion</span>
                                {% else %}
                                    <select class="form-select form-select-sm js-statut badge-select bg-{{ row.statut.couleur }}"
                                            data-url="{{ path('admin_suivi_immersion_update', {id: row.immersionId}) }}"
                                            data-token="{{ csrf_token('suivi_immersion_' ~ row.immersionId) }}">
                                        {% for statut in statutChoices %}
                                            <option value="{{ statut.value }}" data-couleur="{{ statut.couleur }}"
                                                    {{ statut == row.statut ? 'selected' }}>{{ statut.label }}</option>
                                        {% endfor %}
                                    </select>
                                {% endif %}
                            </td>
                            <td class="cell-ell">{% if row.email %}<a href="mailto:{{ row.email }}" title="{{ row.email }}">{{ row.email }}</a>{% else %}—{% endif %}</td>
                            <td class="cell-ell">{% if row.telephone %}<a href="tel:{{ row.telephone }}" title="{{ row.telephone }}">{{ row.telephone }}</a>{% else %}—{% endif %}</td>
                            <td data-sort="{{ row.score ?? -1 }}" class="text-center">
                                {% if row.score is null %}—
                                {% elseif row.score >= 75 %}<span class="badge badge-success">{{ row.score }}%</span>
                                {% elseif row.score >= 50 %}<span class="badge badge-warning">{{ row.score }}%</span>
                                {% else %}<span class="badge badge-danger">{{ row.score }}%</span>
                                {% endif %}
                            </td>
                            <td class="obs js-editable"
                                data-url="{{ path('admin_suivi_volontaire_update', {id: row.volontaireId}) }}"
                                data-token="{{ csrf_token('suivi_volontaire_' ~ row.volontaireId) }}"
                                data-field="observations"
                                contenteditable="true">{{ row.observationsVolontaire }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="12" class="suivi-empty">Aucune immersion pour cette sélection.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script>
        (function () {
            const table = document.querySelector('.js-suivi-table');
            if (!table) return;
            const tbody = table.querySelector('tbody');
            const search = document.querySelector('.js-search');
            const statutFilter = document.querySelector('.js-filter-statut');

            // --- Filtrage (recherche plein texte + statut), côté client ---
            function applyFilters() {
                const q = (search.value || '').toLowerCase().trim();
                const st = statutFilter.value;
                tbody.querySelectorAll('tr').forEach(function (tr) {
                    if (!tr.dataset.statut) return; // ligne "vide"
                    const matchText = !q || tr.textContent.toLowerCase().includes(q);
                    const matchStatut = !st || tr.dataset.statut === st;
                    tr.style.display = (matchText && matchStatut) ? '' : 'none';
                });
            }
            search && search.addEventListener('input', applyFilters);
            statutFilter && statutFilter.addEventListener('change', applyFilters);

            // --- Tri par colonne ---
            // Icône dynamique : fa-sort (neutre) sur les colonnes inactives,
            // fa-arrow-up / fa-arrow-down sur la colonne triée (asc / desc).
            function setArrow(th, dir) {
                const icon = th.querySelector('.arrow');
                if (!icon) return;
                icon.classList.remove('fa-sort', 'fa-arrow-up', 'fa-arrow-down');
                icon.classList.add(dir === 'asc' ? 'fa-arrow-up' : (dir === 'desc' ? 'fa-arrow-down' : 'fa-sort'));
            }

            const headers = table.querySelectorAll('thead th');
            headers.forEach(function (th, index) {
                if (th.classList.contains('no-sort')) return;
                th.addEventListener('click', function () {
                    const type = th.dataset.type || 'text';
                    const asc = th.dataset.dir !== 'asc';
                    headers.forEach(function (h) { delete h.dataset.dir; setArrow(h, null); });
                    th.dataset.dir = asc ? 'asc' : 'desc';
                    setArrow(th, asc ? 'asc' : 'desc');

                    const rows = Array.from(tbody.querySelectorAll('tr')).filter(r => r.dataset.statut);
                    rows.sort(function (a, b) {
                        const av = cellVal(a.children[index], type);
                        const bv = cellVal(b.children[index], type);
                        if (av < bv) return asc ? -1 : 1;
                        if (av > bv) return asc ? 1 : -1;
                        return 0;
                    });
                    rows.forEach(r => tbody.appendChild(r));
                });
            });

            function cellVal(td, type) {
                // La cellule Statut contient un <select> : td.textContent renverrait toutes
                // les options ; on lit la valeur sélectionnée (à jour même après édition inline).
                const statut = td.querySelector('select.js-statut');
                let raw;
                if (statut) {
                    raw = statut.value;
                } else {
                    raw = td.dataset.sort !== undefined ? td.dataset.sort : td.textContent.trim();
                }
                if (type === 'num') return parseFloat(raw) || 0;
                return raw.toLowerCase();
            }

            // --- Édition inline (AJAX) ---
            function save(url, token, field, value, onOk) {
                const body = new URLSearchParams();
                body.append('_token', token);
                body.append(field, value);
                fetch(url, {
                    method: 'POST',
                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                    body: body,
                }).then(function (resp) {
                    return resp.json().then(function (data) { return {ok: resp.ok, data: data}; });
                }).then(function (res) {
                    if (res.ok && res.data.ok) {
                        onOk && onOk(res.data);
                    } else {
                        alert('Échec de l\'enregistrement : ' + (res.data.error || 'erreur inconnue'));
                    }
                }).catch(function () {
                    alert('Échec de l\'enregistrement (réseau).');
                });
            }

            // Statut : select -> POST au change
            table.querySelectorAll('.js-statut').forEach(function (sel) {
                sel.addEventListener('change', function () {
                    save(sel.dataset.url, sel.dataset.token, 'statut', sel.value, function (data) {
                        sel.className = sel.className.replace(/bg-\S+/g, 'bg-' + data.couleur);
                        sel.closest('tr').dataset.statut = data.statut;
                    });
                });
            });

            // Observations : contenteditable -> POST au blur si modifié
            table.querySelectorAll('td.js-editable').forEach(function (td) {
                td.addEventListener('focus', function () { td.dataset.original = td.textContent; });
                td.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); td.blur(); }
                });
                td.addEventListener('blur', function () {
                    const value = td.textContent.trim();
                    if (value === (td.dataset.original || '').trim()) return;
                    save(td.dataset.url, td.dataset.token, td.dataset.field, value);
                });
            });
        })();
    </script>
{% endblock %}
