<style>
    @media print {
        body { background: white !important; font-size: 10pt; }
        .ea-wrapper { display: block !important; grid-template-columns: 1fr !important; }
        .ea-content-wrapper { margin-left: 0 !important; padding: 0 !important; }
        .content { margin: 0 !important; padding: 0 !important; }
        .ea-sidebar, .main-header, .content-header, .responsive-header, .content-top, .content-footer, .ea-detail-actions, .flash-messages, .ea-search-bar, .d-print-none, #flash-messages, .navbar, header, .btn-action-dashboard, .ea-detail, .field-group, .datagrid-row { display: none !important; height: 0 !important; overflow: hidden !important; visibility: hidden !important; }
        .d-print-block { display: block !important; }
        .d-print-inline-block { display: inline-block !important; }

        .row-top-cards { margin-bottom: 6px !important; }
        .row-top-cards .col-md-6.col-lg-4 {
            width: 32.5% !important;
            max-width: 32.5% !important;
            flex: 0 0 32.5% !important;
            float: left !important;
            padding: 0 3px !important;
        }
        .row-top-cards .col-md-6.col-lg-4:first-child { padding-left: 0 !important; }
        .row-top-cards .col-md-6.col-lg-4:last-child { padding-right: 0 !important; }

        .stat-card { padding: 6px !important; margin-bottom: 6px !important; }
        .stat-value { font-size: 18pt !important; margin-bottom: 2px !important; }
        .stat-label { font-size: 8pt !important; line-height: 1.1 !important; }
        .row { margin-bottom: 6px !important; }
        .mb-3, .mb-4 { margin-bottom: 6px !important; }
        .mt-4 { margin-top: 6px !important; }
        .mt-1 { margin-top: 6px !important; }
        .g-4 { gap: 6px !important; }
        h3, h5 { font-size: 11pt !important; margin-bottom: 4px !important; }
        .table { font-size: 8pt !important; }
        .table td, .table th { padding: 3px !important; }

        .stat-card-top { padding: 3px 6px !important; }
        .stat-card-top .stat-value { font-size: 16pt !important; line-height: 1 !important; }
        .stat-card-top .stat-label { font-size: 7pt !important; line-height: 1.1 !important; }
        .stat-card-top i { display: none !important; }
        
        .table-view { display: none !important; }
        .chart-container { display: block !important; height: auto !important; min-height: 150px !important; max-height: 200px !important; width: 100% !important; max-width: 100% !important; overflow: hidden !important; }
        .chart-container canvas { max-height: 200px !important; width: 100% !important; max-width: 100% !important; }
        .stat-card { overflow: visible !important; height: auto !important; min-height: fit-content !important; box-sizing: border-box !important; }
        .stat-card { page-break-inside: avoid !important; }
        .col-md-6 { width: 48% !important; max-width: 48% !important; flex: 0 0 48% !important; float: left !important; padding: 0 3px !important; box-sizing: border-box !important; page-break-inside: avoid !important; }
        .col-md-6:nth-child(odd) { padding-left: 0 !important; }
        .col-md-6:nth-child(even) { padding-right: 0 !important; }
        .row { page-break-inside: avoid !important; clear: both !important; }
        
        #questions-stats-header { page-break-before: always !important; page-break-after: avoid !important; margin-top: 0 !important; padding-top: 0 !important; }
        #questions-stats-container { page-break-before: avoid !important; }
        #questions-stats-header:has(+ #questions-stats-container[style*="display: none"]),
        #questions-stats-container[style*="display: none"] { display: none !important; }
    }
    
    .chart-container {
        margin-top: 1rem;
        position: relative;
        height: 250px;
    }
    .table-view {
        display: none;
    }
    .table-view.active {
        display: table;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

