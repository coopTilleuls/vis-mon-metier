{# JSON encoded inside <script> must escape <, >, &, ', " so user-supplied
   values cannot break out of the script tag or the surrounding JS string. #}
{% set json_safe = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
<script>
const charts = {};
const chartData = {
    byAge: {{ stats.byAge is defined ? (stats.byAge|json_encode(json_safe)|raw) : '[]' }},
    byAccompaniment: {{ stats.byAccompaniment is defined ? (stats.byAccompaniment|json_encode(json_safe)|raw) : '[]' }},
    bySituation: {{ stats.bySituation is defined ? (stats.bySituation|json_encode(json_safe)|raw) : '[]' }},
    byCommune: {{ stats.byCommune is defined ? (stats.byCommune|json_encode(json_safe)|raw) : '[]' }},
    byCommuneParticipants: {{ stats.byCommuneParticipants is defined ? (stats.byCommuneParticipants|json_encode(json_safe)|raw) : '[]' }},
    byDateCount: {{ stats.byDateCount is defined ? (stats.byDateCount|json_encode(json_safe)|raw) : '[]' }}
    {% if stats.byQuestions is defined and stats.byQuestions|length > 0 %}
        {% for question in stats.byQuestions %}
        , {{ question.key|json_encode(json_safe)|raw }}: {{ question.data|json_encode(json_safe)|raw }}
        {% endfor %}
    {% endif %}
};

function createChart(key) {
    const canvas = document.getElementById('canvas-' + key);
    if (!canvas) {
        console.error('Canvas not found for key:', key);
        return;
    }

    const data = chartData[key];
    if (!data || data.length === 0) {
        console.error('No data for key:', key);
        return;
    }

    const MAX_LABEL_LENGTH = 25;
    const truncateLabel = (label) =>
        (typeof label === 'string' && label.length > MAX_LABEL_LENGTH)
            ? label.slice(0, MAX_LABEL_LENGTH - 1).trimEnd() + '…'
            : label;
    // Keep the full labels so the chart tooltip can show them untruncated.
    const fullLabels = data.map(item => item.label);
    const labels = fullLabels.map(truncateLabel);
    const tooltipCallbacks = {
        title: (items) => (items.length ? fullLabels[items[0].dataIndex] : ''),
    };

    // Check if data has separate counts for participants and employers
    const hasTypesSeparated = data[0] && ('countParticipant' in data[0] || 'countEmployeur' in data[0]);
    
    const ctx = canvas.getContext('2d');
    
    if (hasTypesSeparated) {
        const valuesParticipant = data.map(item => item.countParticipant || 0);
        const valuesEmployeur = data.map(item => item.countEmployeur || 0);
        
        charts[key] = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Volontaires',
                        data: valuesParticipant,
                        backgroundColor: '#00a076',
                        borderColor: '#005d55',
                        borderWidth: 1
                    },
                    {
                        label: 'Professionnel·le·s',
                        data: valuesEmployeur,
                        backgroundColor: '#ffeaa7',
                        borderColor: '#fdcb6e',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: tooltipCallbacks
                    }
                }
            }
        });
    } else {
        const values = data.map(item => item.count);
        
        charts[key] = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Nombre',
                    data: values,
                    backgroundColor: '#00a076',
                    borderColor: '#005d55',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: tooltipCallbacks
                    }
                }
            }
        });
    }
}

function toggleChart(key, button) {
    const table = document.getElementById('table-' + key);
    const chartContainer = document.getElementById('chart-' + key);
    const icon = button.querySelector('i');

    if (!table || !chartContainer) {
        console.error('Elements not found for key:', key);
        return;
    }

    if (table.classList.contains('active')) {
        // Currently showing table, switch to chart view
        table.classList.remove('active');
        chartContainer.style.display = 'block';
        icon.className = 'fas fa-table';
    } else {
        // Currently showing chart, switch to table view
        table.classList.add('active');
        chartContainer.style.display = 'none';
        icon.className = 'fas fa-chart-bar';
    }
}

function toggleQuestionsStats() {
    const container = document.getElementById('questions-stats-container');
    const icon = document.getElementById('questions-stats-icon');
    const text = document.getElementById('questions-stats-text');
    
    if (container.style.display === 'none') {
        container.style.display = 'flex';
        icon.className = 'fas fa-chevron-up me-1';
        text.textContent = 'Masquer';
        
        // Initialize charts for questions if not already done
        {% if stats.byQuestions is defined and stats.byQuestions|length > 0 %}
            {% for question in stats.byQuestions %}
            if (!charts[{{ question.key|json_encode(json_safe)|raw }}] && chartData[{{ question.key|json_encode(json_safe)|raw }}] && chartData[{{ question.key|json_encode(json_safe)|raw }}].length > 0) {
                createChart({{ question.key|json_encode(json_safe)|raw }});
            }
            {% endfor %}
        {% endif %}
    } else {
        container.style.display = 'none';
        icon.className = 'fas fa-chevron-down me-1';
        text.textContent = 'Afficher';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    Object.keys(chartData).forEach(key => {
        if (chartData[key] && chartData[key].length > 0) {
            createChart(key);
        }
    });

    document.querySelectorAll('.btn-toggle-chart').forEach(btn => {
        btn.addEventListener('click', () => toggleChart(btn.dataset.chartKey, btn));
    });
    document.querySelectorAll('.btn-toggle-questions-stats').forEach(btn => {
        btn.addEventListener('click', toggleQuestionsStats);
    });
    document.querySelectorAll('.btn-print-stats').forEach(btn => {
        btn.addEventListener('click', () => window.print());
    });
});
</script>
