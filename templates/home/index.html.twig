{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block title %}Accueil - Vis Mon Métier
{% endblock %}

{% block body %}
	<header class="home-header">
		<div class="header-container">
			<img class="home-logo" src="{{ asset('images/brand/' ~ brand.slug ~ '/logo.' ~ brand.logoExt) }}" alt="{{ brand.altLogo }}"/>
		</div>
	</header>
	<div class="home-container">
		<div class="home-content">
			<div class="event-title">
				<span class="event-title-line1">Vis mon métier</span>
				<span class="event-title-line2">{{ brand.subtitle }}</span>
				<div class="event-title-line3">1 Jour - 1 Binôme - 1 Expérience !</div>
			</div>

			<div class="info-section">
				<h3 class="info-title">Qu'est-ce que c'est ?</h3>
				<p>«&nbsp;Vis mon métier&nbsp;» c'est simple&nbsp;: Vous répondez à une série de questions et l'appli «&nbsp;Vis mon métier&nbsp;» vous propose les meilleurs binômes&nbsp;! <strong>Pas de CV, pas de candidature à envoyer, ce sont vos réponses aux questions qui déterminent vos meilleures «&nbsp;compatibilités&nbsp;».</strong> Alors pesez bien chacune de vos réponses, c'est important&nbsp;!</p>
			</div>

			<div class="cards-wrapper">
				<a href="{{ path('app_questionnaire_new') }}" class="card green">
					<svg class="card-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
					</svg>
					<p>Je suis en recherche<br>d'orientation professionnelle</p>
					<button class="btn">Je veux découvrir un métier</button>
				</a>

				<a href="{{ path('app_questionnaire_new', {'pro': 1}) }}" class="card yellow">
					<svg class="card-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1" stroke="currentColor" class="size-6">
						<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z"/>
					</svg>
					<p>Je suis un·e professionnel·le<br>du territoire</p>
					<button class="btn">Je fais découvrir mon métier</button>
				</a>
			</div>

			<div class="info-section">
				<h3 class="info-title">Qui peut y participer ?</h3>
				<p>Les professionnel·le·s <strong>exerçant leur métier sur le territoire de {{ brand.territoire }}</strong>, qui souhaitent partager leur quotidien&nbsp;!</p>
				<p>Les <strong>demandeurs d'emploi, les élèves et les salarié·e·s du territoire</strong>, qui veulent découvrir un métier et un environnement de travail grandeur nature&nbsp;!</p>
			</div>

			<div class="info-section">
				<h3 class="info-title">Mais à quoi ça sert ?!</h3>
				<ul class="info-list">
					<li>À mettre en lumière la <strong>diversité des métiers et des employeurs du territoire</strong></li>
					<li>À avancer dans son choix <strong>d'orientation professionnelle</strong>, à tester de nouvelles pistes&nbsp;!</li>
					<li>À se rencontrer, échanger, <strong>s'étonner</strong>&nbsp;!</li>
				</ul>
			</div>

			<div class="info-section">
				<h3 class="info-title">Comment ça marche ?</h3>
				<div class="home-steps">
					<div class="home-step">
						<span class="home-step-number">1</span>
						<div class="home-step-cols">
							<div>
								<strong>Je suis professionnel·le</strong><br>
								Je m'inscris et j'en dis plus sur mon métier&nbsp;!
							</div>
							<div>
								<strong>Je suis volontaire à l'expérience</strong><br>
								Je m'inscris et je dis ce qui compte pour moi dans mon futur métier
							</div>
						</div>
					</div>
					<div class="home-step">
						<span class="home-step-number">2</span>
						<p>L'application «&nbsp;Vis mon métier&nbsp;» <strong>croise les données</strong> et propose les meilleurs binômes pro/volontaire.</p>
					</div>
					<div class="home-step">
						<span class="home-step-number">3</span>
						<p>{{ brand.communaute }} et ses partenaires <strong>me contactent pour me donner les résultats et mettre en place les journées d'immersion.</strong></p>
					</div>
				</div>
			</div>

			<div class="contact-section">
				<strong>{{ brand.communaute }}</strong><br>
				{{ brand.address }}<br>
				Tél. {{ brand.phone }} – {{ brand.email }}<br>
				{% if brand.website %}<a href="{{ brand.website }}" target="_blank">{{ brand.website|replace({'https://': '', 'http://': ''})|trim('/') }}</a>{% endif %}
			</div>
		</main>
	</div>
	<div class="home-image">
		<img src="{{ asset('images/landing-image.webp') }}" alt=""/>
	</div>
</div>{% endblock %}
